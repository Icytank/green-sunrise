---
import { t, type TranslationKey } from "src/utils/i18n-helpers";
import SectionHeader from "./SectionHeader.astro";

interface Props {
    lang: "bg" | "en";
}

const { lang } = Astro.props;

const title = t("about.intro.title" as TranslationKey, lang);
const text = t("about.intro.text" as TranslationKey, lang);
---

<section
    id="about-intro"
    class="py-gs-section-padding-y pb-[clamp(3rem,6vw,6rem)]"
>
    <div class="w-full max-w-[1280px] mx-auto">
        <SectionHeader
            label={t("about.intro.label" as TranslationKey, lang)}
            title={title}
            description={text}
            align="center"
            withStamp={false}
        />
    </div>
</section>
