---
import { t, type TranslationKey } from "src/utils/i18n-helpers";

interface Props {
    lang: "bg" | "en";
}

const { lang } = Astro.props;

// Helpers to simplify template
const tr = (key: string) => t(`about.${key}` as TranslationKey, lang);
---

<section id="mission-vision" class="px-gs-2 pb-gs-section-padding-y">
    <div
        class="w-full max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-gs-5"
    >
        <!-- Mission -->
        <div
            class="bg-gs-executive-white p-8 sm:p-gs-6 pl-10 sm:pl-gs-5 rounded-lg border-l-4 border-gs-institutional-green shadow-sm"
            data-aos="fade-up"
        >
            <h3 class="text-gs-h4 font-bold text-gs-institutional-green mb-4">
                {tr("mission.title")}
            </h3>
            <p class="text-gs-base text-gs-secondary leading-relaxed m-0">
                {tr("mission.text")}
            </p>
        </div>

        <!-- Vision -->
        <div
            class="bg-gs-executive-white p-8 sm:p-gs-6 pl-10 sm:pl-gs-5 rounded-lg border-l-4 border-gs-institutional-green shadow-sm"
            data-aos="fade-up"
            data-aos-delay="200"
        >
            <h3 class="text-gs-h4 font-bold text-gs-institutional-green mb-4">
                {tr("vision.title")}
            </h3>
            <p class="text-gs-base text-gs-secondary leading-relaxed m-0">
                {tr("vision.text")}
            </p>
        </div>
    </div>
</section>
