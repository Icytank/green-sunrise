---
import { t, type TranslationKey } from "src/utils/i18n-helpers";
import SectionHeader from "./SectionHeader.astro";
import IconCard from "./IconCard.astro";

interface Props {
    lang: "bg" | "en";
}

const { lang } = Astro.props;

const tr = (key: string) => t(`about.values.${key}` as TranslationKey, lang);

const values = [
    { key: "quality", icon: "⭐" },
    { key: "team", icon: "👷" },
    { key: "capability", icon: "🚜" },
    { key: "integrity", icon: "🤝" },
    { key: "responsibility", icon: "🌱" },
];
---

<section id="values" class="py-gs-section-padding-y bg-gs-executive-white">
    <div
        class="w-full max-w-[1280px] mx-auto flex flex-col items-center gap-[clamp(3rem,6vw,4rem)] px-4"
    >
        <SectionHeader
            label={tr("label")}
            title={tr("title")}
            description=""
            align="center"
            withStamp={false}
        />

        <ul
            class="w-full p-0 m-0 list-none grid grid-cols-12 gap-gs-4 lg:flex lg:flex-wrap lg:justify-center"
        >
            {
                values.map((v) => (
                    <li class="col-span-12 md:col-span-6 lg:w-[calc(33.33%-var(--spacing-gs-4))] lg:max-w-[400px]">
                        <IconCard
                            icon={v.icon}
                            title={tr(`list.${v.key}.title`)}
                            description={tr(`list.${v.key}.desc`)}
                            class="h-full"
                        />
                    </li>
                ))
            }
        </ul>
    </div>
</section>
