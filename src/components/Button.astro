---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline";
  class?: string;
  [key: string]: any;
}

const { href, variant = "primary", class: className, ...rest } = Astro.props;

const baseClasses =
  "inline-block w-auto h-[50px] px-[30px] text-[16px] font-bold leading-[50px] text-center uppercase no-underline transition-all duration-300 relative z-1 box-border";

const variantClasses = {
  primary:
    "text-gs-executive-white bg-gs-institutional-green hover:bg-gs-success-emerald hover:-translate-y-0.5",
  outline:
    "text-gs-institutional-green bg-transparent border-2 border-gs-institutional-green hover:bg-gs-institutional-green hover:text-gs-executive-white",
  secondary:
    "text-gs-executive-white bg-transparent border-2 border-gs-executive-white hover:bg-gs-executive-white hover:text-gs-institutional-green",
};

const classes = [baseClasses, variantClasses[variant], className];
---

<a href={href} class:list={classes} {...rest}>
  <slot />
</a>
