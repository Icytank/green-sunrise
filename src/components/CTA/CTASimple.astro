---
/**
 * * Simplified CTA component using Astro's built-in Picture component
 **/

// Utils
import { Picture } from "astro:assets";
import { t } from "@utils/i18n-helpers";

// Images
import ctaImage from "@assets/images/home-cta.jpg";

interface Props {
	lang: "bg" | "en";
}

const { lang } = Astro.props;
---

<section
	id="cta"
	class="relative py-[50px] lg:py-[168px] xl:mt-[100px] z-[1] flex items-center justify-center overflow-hidden"
>
	<div class="relative z-10 text-center px-4 xl:w-[90.0625%] xl:mx-auto">
		<h2
			class="text-[clamp(2.25rem,9vw,3rem)] font-black leading-tight text-center mb-9 text-white relative"
		>
			{t("cta.title", lang)}
		</h2>
		<p
			class="text-center w-[96%] max-w-[598px] mx-auto mb-9 text-white leading-relaxed"
		>
			{t("cta.description", lang)}
		</p>
		<a
			href={`/${lang}/contact/`}
			class="inline-block px-8 py-4 bg-gs-institutional-green text-white text-[16px] font-bold no-underline uppercase tracking-widest rounded transition-all duration-300 hover:bg-gs-success-emerald hover:-translate-y-[2px]"
		>
			{t("cta.button", lang)}
		</a>
	</div>

	<!-- Background and Decorative Elements -->
	<div class="absolute inset-0 z-[-1]">
		<Picture
			src={ctaImage}
			alt=""
			layout="full-width"
			formats={["avif", "webp"]}
			class="w-full h-full object-cover"
		/>
		<div class="absolute inset-0 bg-black/70"></div>
	</div>

	<!-- Decorative Squares for Large Screens -->
</section>
