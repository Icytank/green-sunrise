---
interface Props {
  lang?: "en" | "bg";
}

const { lang = "en" } = Astro.props;

const translations = {
  en: {
    legend: "Project Details",
    name: "Name",
    company: "Company",
    email: "Email",
    phone: "Phone",
    projectType: "Project Type",
    typeUtility: "Utility-scale",
    typeCommercial: "Commercial & Industrial (C&I)",
    message: "Message",
    submit: "Submit Inquiry",
    sending: "Sending...",
    success: "Thank you! We will contact you shortly.",
    error: "Something went wrong. Please try again or email us.",
  },
  bg: {
    legend: "Детайли за проекта",
    name: "Име",
    company: "Компания",
    email: "Имейл",
    phone: "Телефон",
    projectType: "Тип проект",
    typeUtility: "Ютилити (Utility-scale)",
    typeCommercial: "Търговски и Индустриален (C&I)",
    message: "Съобщение",
    submit: "Изпрати запитване",
    sending: "Изпращане...",
    success: "Благодарим Ви! Ще се свържем с вас скоро.",
    error: "Възникна грешка. Моля, опитайте отново или ни пишете.",
  },
};

const t = translations[lang];
---

<!-- Turnstile Script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<form
  id="cs-form"
  name="contact"
  method="POST"
  class="flex flex-wrap gap-y-gs-6 gap-x-gs-4"
  data-sending={t.sending}
  data-success={t.success}
  data-error={t.error}
>
  <!-- Honeypot -->
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="lang" value={lang} />
  <p class="hidden">
    <label
      >Don’t fill this out if you’re human: <input name="bot-field" /></label
    >
  </p>

  <label
    class="flex flex-col gap-gs-2 w-full sm:w-[calc(50%-16px)] font-bold text-gs-slate-gray uppercase tracking-widest text-[10px] sm:text-xs"
  >
    {t.name}
    <input
      required
      type="text"
      name="name"
      placeholder={t.name}
      class="w-full bg-[#f9fbfb] border border-gs-slate-gray/15 rounded-xl h-16 px-gs-5 text-gs-text-primary focus:border-[#064E3B] focus:ring-1 focus:ring-[#064E3B] outline-none transition-all placeholder:text-gs-slate-gray/30 font-medium"
    />
  </label>

  <label
    class="flex flex-col gap-gs-2 w-full sm:w-[calc(50%-16px)] font-bold text-gs-slate-gray uppercase tracking-widest text-[10px] sm:text-xs"
  >
    {t.email}
    <input
      required
      type="email"
      name="email"
      placeholder={t.email}
      class="w-full bg-[#f9fbfb] border border-gs-slate-gray/15 rounded-xl h-16 px-gs-5 text-gs-text-primary focus:border-[#064E3B] focus:ring-1 focus:ring-[#064E3B] outline-none transition-all placeholder:text-gs-slate-gray/30 font-medium"
    />
  </label>

  <label
    class="flex flex-col gap-gs-2 w-full sm:w-[calc(50%-16px)] font-bold text-gs-slate-gray uppercase tracking-widest text-[10px] sm:text-xs"
  >
    {t.phone}
    <input
      type="tel"
      name="phone"
      placeholder={t.phone}
      class="w-full bg-[#f9fbfb] border border-gs-slate-gray/15 rounded-xl h-16 px-gs-5 text-gs-text-primary focus:border-[#064E3B] focus:ring-1 focus:ring-[#064E3B] outline-none transition-all placeholder:text-gs-slate-gray/30 font-medium"
    />
  </label>

  <label
    class="flex flex-col gap-gs-2 w-full sm:w-[calc(50%-16px)] font-bold text-gs-slate-gray uppercase tracking-widest text-[10px] sm:text-xs"
  >
    {t.company}
    <input
      required
      type="text"
      name="company"
      placeholder={t.company}
      class="w-full bg-[#f9fbfb] border border-gs-slate-gray/15 rounded-xl h-16 px-gs-5 text-gs-text-primary focus:border-[#064E3B] focus:ring-1 focus:ring-[#064E3B] outline-none transition-all placeholder:text-gs-slate-gray/30 font-medium"
    />
  </label>

  <fieldset
    class="w-full border border-gs-slate-gray/15 rounded-xl p-8 bg-[#f9fbfb]/50"
  >
    <legend
      class="px-4 text-[10px] sm:text-xs font-bold text-gs-slate-gray uppercase tracking-widest bg-white rounded-full border border-gs-slate-gray/15"
      >{t.projectType}</legend
    >
    <div class="flex flex-col md:flex-row gap-8">
      <label class="flex items-center gap-4 cursor-pointer group">
        <div class="relative flex items-center justify-center">
          <input
            required
            type="radio"
            name="projectType"
            value="Utility"
            class="peer appearance-none w-6 h-6 border-2 border-gs-slate-gray/30 rounded-md checked:bg-[#064E3B] checked:border-[#064E3B] transition-all"
          />
          <div
            class="radio-visual peer-checked:opacity-100 opacity-0 absolute pointer-events-none text-white font-bold text-sm"
          >
            ✓
          </div>
        </div>
        <span
          class="text-gs-base font-bold text-[#064E3B] group-hover:text-gs-institutional-green transition-colors"
          >{t.typeUtility}</span
        >
      </label>
      <label class="flex items-center gap-4 cursor-pointer group">
        <div class="relative flex items-center justify-center">
          <input
            required
            type="radio"
            name="projectType"
            value="Roof-top"
            class="peer appearance-none w-6 h-6 border-2 border-gs-slate-gray/30 rounded-md checked:bg-[#064E3B] checked:border-[#064E3B] transition-all"
          />
          <div
            class="radio-visual peer-checked:opacity-100 opacity-0 absolute pointer-events-none text-white font-bold text-sm"
          >
            ✓
          </div>
        </div>
        <span
          class="text-gs-base font-bold text-[#064E3B] group-hover:text-gs-institutional-green transition-colors"
          >{t.typeCommercial}</span
        >
      </label>
    </div>
  </fieldset>

  <label
    class="flex flex-col gap-gs-3 w-full font-bold text-gs-slate-gray uppercase tracking-widest text-[10px] sm:text-xs"
  >
    {t.message}
    <textarea
      required
      name="message"
      placeholder={t.message}
      class="w-full bg-[#f9fbfb] border border-gs-slate-gray/15 rounded-xl min-h-[160px] p-gs-6 text-gs-text-primary focus:border-[#064E3B] focus:ring-1 focus:ring-[#064E3B] outline-none transition-all placeholder:text-gs-slate-gray/30 font-medium resize-y"
    ></textarea>
  </label>

  <div
    class="cf-turnstile mt-2"
    data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
    data-error-callback="onTurnstileError"
  >
  </div>

  <button
    class="w-full bg-[#064E3B] text-white py-gs-6 px-gs-10 rounded-2xl font-bold text-gs-lg shadow-xl shadow-[#064E3B]/20 transition-all duration-300 hover:bg-gs-institutional-green-dark hover:-translate-y-1 hover:shadow-2xl disabled:opacity-70 disabled:cursor-wait"
    type="submit"
  >
    {t.submit}
  </button>

  <div class="w-full mt-gs-6 font-bold text-center" aria-live="polite">
    <div id="status-message" class="text-gs-base"></div>
  </div>
</form>

<script>
  import { handleSubmit } from "./ContactFormLogic";

  const initTurnstile = () => {
    const form = document.getElementById("cs-form") as HTMLFormElement;
    const statusMessage = form?.querySelector("#status-message") as HTMLElement;
    const submitBtn = form?.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const turnstileContainer = form?.querySelector(
      ".cf-turnstile",
    ) as HTMLElement;

    if (form) {
      // Re-initialize Turnstile if needed (for View Transitions)
      if ((window as any).turnstile && turnstileContainer) {
        // If the element is empty, we render.
        // Note: The script tag in HTML body might trigger auto-render on first load.
        // But on navigation, we need to handle it.
        // Check if it's already rendered? Turnstile replaces the content?
        // Simplest is to just call render if waiting.
        try {
          (window as any).turnstile.render(turnstileContainer, {
            sitekey: turnstileContainer.dataset.sitekey,
            callback: function (token: string) {
              // optional: handle success
            },
            "error-callback": function () {
              (window as any).onTurnstileError();
            },
          });
        } catch (e) {
          // It might throw if already rendered or verifying.
          // We can ignore or handle gracefully.
        }
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          const originalText = submitBtn.innerText;
          submitBtn.innerText = form.getAttribute("data-sending") || "...";

          const formData = new FormData(form);
          const result = await handleSubmit(formData);

          if (result.success) {
            form.reset();
            if ((window as any).turnstile) (window as any).turnstile.reset(); // Reset widget
            if (statusMessage) {
              statusMessage.innerText =
                form.getAttribute("data-success") || "Success";
              statusMessage.className = "text-[#064E3B] text-gs-lg";
            }
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
          } else {
            if (statusMessage) {
              statusMessage.innerText =
                form.getAttribute("data-error") || "Error";
              statusMessage.className = "text-gs-secondary text-gs-lg";
            }
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
          }
        }
      });

      (window as any).onTurnstileError = function () {
        if (statusMessage) {
          statusMessage.innerText =
            form.getAttribute("data-error") ||
            "Security check failed. Please refresh.";
          statusMessage.className = "text-gs-secondary text-gs-lg";
          if (submitBtn) submitBtn.disabled = true;
        }
      };
    }
  };

  // Run on initial load
  initTurnstile();

  // Run on View Transition navigation
  document.addEventListener("astro:page-load", initTurnstile);
</script>

<style>
  /* Custom Radio Overrides - Ensure the ✓ is visible */
  .radio-visual {
    pointer-events: none;
  }
</style>
