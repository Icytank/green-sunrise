---
/**
 * INSTITUTIONAL FOOTER COMPONENT
 * ==============================
 *
 * Provides a persistent corporate footer with legal and contact information.
 * Supports i18n via the [lang] route structure.
 */

// Utils
import { Icon } from "astro-icon/components";
import { getCurrentYear } from "@utils/utils";
import { getTranslatedPath } from "@utils/i18n-helpers";

// Components
import { Image } from "astro:assets";
import stampLogo from "@assets/images/gs-stamp.png";
import SocialLinks from "@components/SocialLinks.astro";

// Data
import { BUSINESS } from "@data/client";
import { getFooterData } from "./FooterLogic";

interface Props {
	lang: string;
}

const { lang } = Astro.props as Props;
const currentYear = getCurrentYear();
const currentLang = lang === "bg" || lang === "en" ? lang : "en";

const footerData = getFooterData(currentLang);
const getLocalizedUrl = (url: string) => getTranslatedPath(url, currentLang);
---

<footer
	id="footer"
	class="bg-gs-deep-navy-slate py-[5.25rem] px-4 pb-5 text-gs-executive-white font-gs-primary"
>
	<div
		class="mx-auto flex w-full max-w-[1280px] flex-col items-center lg:flex-row lg:items-start lg:justify-between"
	>
		<div class="mb-[3.125rem] text-center lg:m-0 lg:w-[350px] lg:text-left">
			<a
				class="logo mb-8 inline-block"
				href={getLocalizedUrl("/")}
				aria-label="Return to Green Sunrise Home page"
			>
				<Image
					src={stampLogo}
					alt="Green Sunrise Logo"
					width={210}
					height={28}
					class="block h-auto w-full max-w-[210px]"
				/>
			</a>
			<p
				class="mx-auto my-6 max-w-[307px] text-sm leading-[1.6] opacity-80 lg:mx-0 lg:text-left"
			>
				{footerData.description}
			</p>
			<SocialLinks
				className="footer-socials flex w-full justify-center lg:justify-start"
			/>
		</div>
		<div
			class="mx-auto w-full max-w-[407px] lg:m-0 lg:w-[750px] lg:max-w-none"
		>
			<div
				class="flex flex-col gap-10 text-center lg:grid lg:grid-cols-3 lg:gap-8 lg:text-left"
			>
				<ul class="m-0 list-none p-0">
					<li class="mb-6">
						<h2
							class="relative text-[1.125rem] font-bold uppercase after:mx-auto after:mt-2 after:block after:h-[2px] after:w-16 after:bg-gs-institutional-green lg:after:mx-0 lg:after:bg-gs-success-emerald"
						>
							{footerData.navigation.header}
						</h2>
					</li>
					{
						footerData.navigation.items.map((entry) => (
							<li class="mb-3 opacity-90 lg:opacity-100">
								<a
									href={entry.url}
									class="relative no-underline transition-colors hover:text-gs-success-emerald after:absolute after:bottom-[-2px] after:left-0 after:hidden after:h-[1px] after:w-0 after:bg-gs-institutional-green after:transition-all after:duration-300 hover:after:w-full lg:after:block"
								>
									{entry.key}
								</a>
							</li>
						))
					}
				</ul>
				<ul class="m-0 list-none p-0">
					<li class="mb-6">
						<h2
							class="relative text-[1.125rem] font-bold uppercase after:mx-auto after:mt-2 after:block after:h-[2px] after:w-16 after:bg-gs-institutional-green lg:after:mx-0 lg:after:bg-gs-success-emerald"
						>
							{footerData.services.header}
						</h2>
					</li>
					{
						footerData.services.items.map((item) => (
							<li class="mb-3 opacity-90 lg:opacity-100">
								<a
									href={item.url}
									class="relative no-underline transition-colors hover:text-gs-success-emerald after:absolute after:bottom-[-2px] after:left-0 after:hidden after:h-[1px] after:w-0 after:bg-gs-institutional-green after:transition-all after:duration-300 hover:after:w-full lg:after:block"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<ul class="m-0 list-none p-0">
					<li class="mb-6">
						<h2
							class="relative text-[1.125rem] font-bold uppercase after:mx-auto after:mt-2 after:block after:h-[2px] after:w-16 after:bg-gs-institutional-green lg:after:mx-0 lg:after:bg-gs-success-emerald"
						>
							{footerData.contact.header}
						</h2>
					</li>
					<li class="mb-3 opacity-90 lg:opacity-100">
						<div class="mb-2 leading-[1.5]">
							{footerData.contact.addressLines}<br />
							{footerData.contact.cityName}, {
								footerData.contact.country
							}<br />
						</div>
					</li>
					<li class="mb-3 opacity-90 lg:opacity-100">
						<a
							href={`tel:${BUSINESS.phoneForTel}`}
							class="relative no-underline transition-colors hover:text-gs-success-emerald after:absolute after:bottom-[-2px] after:left-0 after:hidden after:h-[1px] after:w-0 after:bg-gs-institutional-green after:transition-all after:duration-300 hover:after:w-full lg:after:block"
						>
							{BUSINESS.phoneFormatted}
						</a>
					</li>
					<li class="mb-3 opacity-90 lg:opacity-100">
						<a
							href={`mailto:${BUSINESS.email}`}
							class="relative no-underline transition-colors hover:text-gs-success-emerald after:absolute after:bottom-[-2px] after:left-0 after:hidden after:h-[1px] after:w-0 after:bg-gs-institutional-green after:transition-all after:duration-300 hover:after:w-full lg:after:block"
							>{BUSINESS.email}</a
						>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div
		class="mt-[6.25rem] border-t border-white/10 pt-8 text-center text-sm text-gs-executive-white"
	>
		<span>&copy; {currentYear} Green Sunrise LTD. All rights reserved.</span
		>
	</div>
</footer>
