---
/**
 * DYNAMIC HEADER COMPONENT
 * ========================
 *
 * This header uses data-driven navigation from src/data/navData.json and supports i18n.
 *
 */

// Utils
import { Icon } from "astro-icon/components";
import { isCurrentPage, getDropdownId } from "@utils/utils.js";
import { getTranslatedPath } from "@utils/i18n-helpers";

// Components
import { Image } from "astro:assets";

import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import stampLogo from "@assets/images/gs-stamp.png";

// Logic
import { getNavigation, getCTALabel } from "./HeaderLogic";

interface Props {
	lang: string;
}

const { lang } = Astro.props as Props;
const currentLang = lang === "bg" || lang === "en" ? lang : "en";

const navigation = getNavigation(currentLang);
const ctaLabel = getCTALabel(currentLang);

// Use centralized helper for other links
const getLocalizedUrl = (url: string) => getTranslatedPath(url, currentLang);

const currentPath = Astro.url.pathname;
---

<!-- 
    NOTE on navigation script compatibility:
    The script in @utils/nav.ts relies on the following selectors:
    - #cs-navigation
    - #cs-navigation .cs-toggle
    - #cs-ul-wrapper
    - .cs-dropdown-toggle
    - .cs-dropdown
    - .cs-drop-ul
    - .cs-nav-button
    And toggles these classes:
    - cs-active (on #cs-navigation, .cs-toggle, .cs-dropdown)
    - cs-open (on body)
-->

<header 
    id="cs-navigation" 
    class="fixed z-[10000] flex w-full box-border items-center bg-gs-executive-white px-4 py-3 font-gs-primary shadow-[0_8px_24px_rgba(149,157,165,0.2)] lg:px-4 lg:py-0 transition-all duration-300
           before:absolute before:top-full before:right-0 before:z-[-11] before:block before:h-screen before:w-0 before:bg-black/60 before:opacity-0 before:backdrop-blur-sm before:transition-all before:duration-300 before:ease-out
           [&.cs-active]:before:w-screen [&.cs-active]:before:opacity-100"
>
	<div class="mx-auto flex w-full max-w-[1280px] items-center justify-between lg:justify-end lg:gap-0">
		<!--Nav Logo-->
		<a
			href={getLocalizedUrl("/")}
			class="cs-logo relative z-[101] flex h-full w-[40%] max-w-[146px] flex-shrink-0 items-center justify-center p-0 lg:h-[88px] lg:w-auto lg:max-w-[350px] lg:mr-auto"
			aria-label="Return to Green Sunrise Home page"
		>
			<Image
				src={stampLogo}
				alt="Green Sunrise Stamp Logo"
				width={200}
				height={27}
				loading="eager"
				fetchpriority="high"
                class="h-auto w-full object-contain object-left"
			/>
		</a>

        <!-- Desktop Right Section -->
        <div class="flex items-center lg:gap-6 xl:gap-10">
            <!--Navigation List-->
            <nav class="cs-nav flex items-center order-2 lg:order-none" aria-label="main navigation">
                <!--Mobile Nav Toggle-->
                <button
                    class="cs-toggle group relative z-[102] ml-auto flex h-[clamp(2.75rem,6vw,3rem)] w-[clamp(2.75rem,6vw,3rem)] items-center justify-center border-none bg-transparent lg:hidden"
                    id="cs-toggle"
                    aria-expanded="false"
                    aria-controls="cs-ul-wrapper"
                    aria-haspopup="menu"
                    aria-label="mobile menu toggle"
                >
                    <span class="cs-box relative h-[clamp(0.875rem,1.5vw,1rem)] w-[clamp(1.5rem,2vw,1.75rem)]" aria-hidden="true">
                        <span class="cs-line cs-line1 absolute left-1/2 top-0 h-[2px] w-full -translate-x-1/2 rounded-[2px] bg-gs-text-primary transition-all duration-300 ease-out group-[.cs-active]:top-1/2 group-[.cs-active]:-translate-y-1/2 group-[.cs-active]:rotate-[225deg]" aria-hidden="true"></span>
                        <span class="cs-line cs-line2 absolute left-1/2 top-1/2 h-[2px] w-full -translate-x-1/2 -translate-y-1/2 rounded-[2px] bg-gs-text-primary transition-all duration-300 ease-out group-[.cs-active]:rotate-[-225deg]" aria-hidden="true"></span>
                        <span class="cs-line cs-line3 absolute bottom-0 left-1/2 h-[2px] w-full -translate-x-1/2 rounded-[2px] bg-gs-text-primary transition-all duration-300 group-[.cs-active]:bottom-full group-[.cs-active]:opacity-0" aria-hidden="true"></span>
                    </span>
                </button>

                <!-- We need a wrapper div so we can set a fixed height on the cs-ul in case the nav list gets too long from too many dropdowns being opened and needs to have an overflow scroll. -->
                <div 
                    class="cs-ul-wrapper absolute top-full right-0 z-[-1] h-screen w-full origin-top-right scale-x-0 overflow-hidden bg-gs-executive-white opacity-0 shadow-[inset_0_8px_24px_rgba(0,0,0,0.2)] transition-all duration-300 
                           lg:relative lg:top-0 lg:z-auto lg:h-auto lg:w-auto lg:scale-x-100 lg:overflow-visible lg:bg-transparent lg:opacity-100 lg:shadow-none lg:transition-none
                           [.cs-active_&]:scale-x-100 [.cs-active_&]:opacity-100" 
                    id="cs-ul-wrapper"
                >
                    <ul id="cs-expanded" class="cs-ul m-0 flex h-[65vh] flex-col items-end justify-start gap-5 overflow-y-auto pl-[70px] pr-[clamp(1.75rem,3vw,2.5rem)] py-12 lg:h-auto lg:flex-row lg:items-center lg:justify-start lg:gap-1 lg:overflow-visible lg:p-0">
                        {
                            navigation.map((entry, index) => (
                                <li
                                    class:list={[
                                        "cs-li w-full list-none text-right opacity-0 -translate-x-10 transition-all duration-700 ease-out lg:w-auto lg:flex-none lg:px-4 lg:py-8 lg:text-left lg:opacity-100 lg:translate-x-0",
                                        {
                                            "[.cs-active_&]:opacity-100 [.cs-active_&]:translate-x-0": true,
                                        },
                                        {
                                            "cs-dropdown group/drop relative":
                                                (entry.children?.length ?? 0) > 0,
                                        },
                                    ]}
                                    style={`transition-delay: ${(index + 1) * 0.05}s`}
                                >
                                    {(entry.children?.length ?? 0) > 0 ? (
                                        // If entry has children in navData.json, create a button and a dropdown icon
                                        <button
                                            id={getDropdownId(entry.key)}
                                            aria-expanded="false"
                                            aria-haspopup="menu"
                                            class:list={[
                                                "cs-li-link cs-dropdown-toggle group/link relative inline-block shrink-0 cursor-pointer border-none bg-transparent m-0 p-0 text-[18px] lg:text-[16px] font-bold leading-[1.2em] text-gs-text-primary no-underline transition-colors lg:leading-[1.5em]",
                                                {
                                                    "cs-active text-gs-institutional-green":
                                                        currentPath.includes(
                                                            entry.url,
                                                        ),
                                                },
                                            ]}
                                        >
                                            {entry.key}
                                            <Icon
                                                name="mdi--caret"
                                                class="cs-drop-icon ml-1 inline-block h-auto w-[15px] rotate-180 transition-transform duration-300 group-[.cs-active]/drop:rotate-0 lg:group-hover/drop:rotate-0"
                                            />
                                            <!-- Underline effect Desktop -->
                                            <span class="absolute bottom-[-2px] left-0 hidden h-[2px] w-0 bg-gs-institutional-green lg:block lg:transition-all lg:duration-300 lg:group-hover/link:w-full lg:group-[.cs-active]/link:w-full lg:group-[.cs-active]/drop:w-full"></span>
                                        </button>
                                    ) : (
                                        // If entry does not have children in navData.json, create an anchor
                                        <a
                                            href={entry.url}
                                            class:list={[
                                                "cs-li-link group/link relative inline-block text-[18px] lg:text-[16px] shrink-0 font-bold leading-[1.2em] text-gs-text-primary no-underline transition-colors lg:leading-[1.5em]",
                                                {
                                                    "cs-active text-gs-institutional-green":
                                                        currentPath === entry.url,
                                                },
                                            ]}
                                            aria-current={isCurrentPage(
                                                currentPath,
                                                entry.url,
                                            )}
                                        >
                                            {entry.key}
                                            <!-- Underline effect Desktop -->
                                            <span class="absolute bottom-[-2px] left-0 hidden h-[2px] w-0 bg-gs-institutional-green lg:block lg:transition-all lg:duration-300 lg:group-hover/link:w-full lg:group-[.cs-active]/link:w-full"></span>
                                        </a>
                                    )}

                                    {(entry.children?.length ?? 0) > 0 && (
                                        // If entry has children in navData.json, create a drop down menu
                                        <ul
                                            class="cs-drop-ul box-border flex flex-col items-end justify-start gap-3 h-0 scale-0 overflow-hidden bg-gs-institutional-green m-0 p-0 origin-top-right opacity-0 transition-all duration-300 visibility-hidden
                                                   group-[.cs-active]/drop:h-auto group-[.cs-active]/drop:mt-3 group-[.cs-active]/drop:p-6 group-[.cs-active]/drop:scale-100 group-[.cs-active]/drop:opacity-100 group-[.cs-active]/drop:visible
                                                   lg:absolute lg:top-full lg:z-[-100] lg:h-auto lg:min-w-[200px] lg:scale-y-0 lg:bg-gs-executive-white lg:opacity-0 lg:shadow-lg lg:border-b-[5px] lg:border-gs-institutional-green lg:transition-all lg:duration-300 lg:origin-top lg:group-hover/drop:scale-y-100 lg:group-hover/drop:opacity-100 lg:group-hover/drop:visible lg:p-0 lg:gap-0 lg:items-start"
                                            aria-labelledby={getDropdownId(
                                                entry.key,
                                            )}
                                        >
                                            {entry.children?.map((child: any, subIndex: number) => (
                                                <li class="cs-drop-li w-full list-none text-inherit lg:opacity-0 lg:-translate-y-[10px] lg:transition-all lg:duration-600 lg:group-hover/drop:opacity-100 lg:group-hover/drop:translate-y-0"
                                                    style={`transition-delay: ${(subIndex + 1) * 0.05}s`}
                                                >
                                                    <a
                                                        href={child.url}
                                                        class="cs-li-link cs-drop-link block w-full box-border px-3 text-[14px] text-gs-executive-white no-underline transition-all
                                                               lg:text-[16px] lg:leading-[1.5em] lg:text-gs-slate-gray lg:p-3 lg:hover:bg-gray-100 lg:hover:text-gs-institutional-green"
                                                        aria-current={isCurrentPage(
                                                            currentPath,
                                                            child.url,
                                                        )}
                                                    >
                                                        {child.key}
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </nav>

            <!-- Language Switcher -->
            <div class="header-lang-switcher flex order-1 mr-4 lg:flex lg:order-none lg:mr-0 font-gs-primary font-bold text-sm text-gs-slate-gray">
                <LanguageSwitcher />
            </div>

            <a
                href={getLocalizedUrl("/contact/")}
                class="cs-button-solid cs-nav-button hidden rounded-[4px] bg-gs-institutional-green px-6 py-3 font-gs-primary font-bold text-gs-executive-white no-underline transition-colors hover:bg-[#043e2f] lg:block"
            >
                {ctaLabel}
            </a>
        </div>
	</div>
</header>
