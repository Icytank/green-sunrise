---
import { t, type TranslationKey } from "src/utils/i18n-helpers";
import SectionHeader from "./SectionHeader.astro";
import IconCard from "./IconCard.astro";

interface Props {
  lang: "bg" | "en";
}

const { lang } = Astro.props;

const translate = (key: string) =>
  t(`home.advantages.${key}` as TranslationKey, lang);

const advantages = [
  { key: "expertise", icon: "🏆" }, // Using emojis as placeholders for icons to keep it simple and light
  { key: "machinery", icon: "🚜" },
  { key: "precision", icon: "🎯" },
  { key: "workflow", icon: "⚙️" },
  { key: "partnership", icon: "🤝" },
];
---

<section
  id="advantages"
  class="py-[clamp(3.75rem,7.82vw,6.25rem)] px-4 bg-gs-executive-white overflow-hidden"
>
  <div
    class="w-full max-w-[1280px] mx-auto flex flex-col items-center gap-[clamp(3rem,6vw,4rem)]"
  >
    <!-- Header -->
    <SectionHeader
      label={t("home.teamLabel" as TranslationKey, lang)}
      title={translate("title")}
      description=""
      align="center"
    />

    <!-- Grid -->
    <ul class="w-full m-0 p-0 flex flex-wrap justify-center gap-gs-4 list-none">
      {
        advantages.map((adv) => (
          <li class="list-none w-full md:w-[calc((100%-var(--spacing-gs-4))/2)] lg:w-[calc((100%-2*var(--spacing-gs-4))/3)] lg:max-w-[400px]">
            <IconCard
              icon={adv.icon}
              title={translate(`${adv.key}.title`)}
              description={translate(`${adv.key}.desc`)}
              class="h-full"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
