---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import { t, type TranslationKey } from "src/utils/i18n-helpers";

interface Props {
  lang: "bg" | "en";
  heroImage?: any;
}

const { lang } = Astro.props;

// Helper to get translation with type safety for this component
const translate = (key: string) => t(`hero.${key}` as TranslationKey, lang);

import defaultHeroImage from "@assets/images/home-hero.png";
const { heroImage = defaultHeroImage } = Astro.props;
---

<section
  id="hero"
  class="relative z-1 overflow-hidden text-center px-4 pt-[clamp(3rem,15vw,15.625rem)] pb-[clamp(3.75rem,10vw,6.25rem)] md:text-left"
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-[-2] w-full h-full">
    <div class="absolute inset-0 bg-black/58 z-[1]"></div>
    <Image
      src={heroImage}
      alt="Solar PV site construction with pile drivers"
      width={1920}
      height={1080}
      widths={[360, 720, 1300, 1920]}
      sizes="100vw"
      quality={40}
      fit="cover"
      position="center"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover"
    />
  </div>

  <div
    class="w-full max-w-[1280px] mx-auto flex flex-col justify-center items-center md:justify-start md:items-start"
  >
    <div
      class="max-w-[630px] w-full flex flex-col justify-center items-center md:items-start md:text-left md:max-w-[800px]"
    >
      <h1
        class="text-[clamp(2.4375rem,6.4vw,3.8125rem)] font-black leading-tight text-center mx-auto mb-4 text-white relative text-balance md:text-left md:ml-0 drop-shadow-lg"
        data-aos="fade-up"
      >
        {translate("title")}
      </h1>
      <p
        class="text-[clamp(1rem,2.5vw,1.25rem)] leading-relaxed text-center w-full max-w-[520px] mx-auto mb-8 text-white/90 text-pretty md:text-left md:ml-0 font-medium drop-shadow-md"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        {translate("subtitle")}
      </p>
      <div
        class="flex justify-center items-center gap-4 flex-wrap md:justify-start"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <Button href={`/${lang}/projects`} variant="primary"
          >{translate("viewProjects")}</Button
        >
        <Button href={`/${lang}/contact`} variant="secondary"
          >{translate("requestSpecs")}</Button
        >
      </div>
    </div>
  </div>
</section>
