---
import { Image } from "astro:assets";
import GSStamp from "./GSStamp.astro";
import { getMachineryUrl, formatSpecValue } from "./MachineryCard.logic";
import { t } from "../utils/i18n-helpers";

interface Props {
  title: string;
  model: string;
  weight: string;
  image: ImageMetadata;
  slug: string;
  lang: "bg" | "en";
  isOwned?: boolean;
  animationDelay?: number;
}

const {
  title,
  model,
  weight,
  image,
  slug,
  lang,
  isOwned = true,
  animationDelay = 0,
} = Astro.props;
const url = getMachineryUrl(slug, lang);
const formattedWeight = formatSpecValue(weight, "");
const ownedBadgeLabel = t("machinery.ownedBadge", lang);
const ownershipDeclaration = t("machinery.ownershipDeclaration", lang);
---

<a
  href={url}
  class="group flex flex-col bg-gs-executive-white border border-gs-slate-gray/20 rounded-xl overflow-hidden no-underline text-gs-text-primary transition-all duration-400 ease-[cubic-bezier(0.165,0.84,0.44,1)] h-full relative hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,78,59,0.12)] hover:border-gs-institutional-green focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-gs-institutional-green"
  aria-label={`${title} - ${model}`}
  data-aos="fade-up"
  data-aos-delay={animationDelay}
>
  <div class="relative w-full aspect-[4/3] overflow-hidden bg-gs-slate-gray">
    <Image
      src={image}
      alt={title}
      width={800}
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      quality={50}
      class="w-full h-full object-cover transition-transform duration-600 ease-[cubic-bezier(0.165,0.84,0.44,1)] group-hover:scale-110"
    />
    {
      isOwned && (
        <div
          class="absolute top-gs-2 right-gs-2 z-10 transition-transform duration-300 group-hover:rotate-[15deg] group-hover:scale-110"
          title={ownedBadgeLabel}
          aria-label={ownedBadgeLabel}
        >
          <GSStamp size={60} />
        </div>
      )
    }
    <!-- Audit-on-Hover Overlay -->
    <div
      class="absolute inset-0 bg-gs-institutional-green/85 flex items-center justify-center opacity-0 transition-opacity duration-400 p-gs-4 pointer-events-none group-hover:opacity-100"
    >
      <div
        class="text-center text-white translate-y-[20px] transition-transform duration-400 ease-[cubic-bezier(0.165,0.84,0.44,1)] group-hover:translate-y-0"
      >
        <span
          class="block text-gs-xs uppercase tracking-[0.1em] opacity-80 mb-gs-1"
          >{t("machinery.model", lang)}</span
        >
        <span class="block text-gs-h4 font-bold font-gs-mono mb-gs-3"
          >{model}</span
        >
        <div class="h-[2px] w-[40px] bg-gs-success-emerald mx-auto mb-gs-3">
        </div>
        <span
          class="block text-gs-xs uppercase tracking-[0.1em] opacity-80 mb-gs-1"
          >{t("machinery.weight", lang)}</span
        >
        <span class="block text-gs-h4 font-bold font-gs-mono mb-gs-3"
          >{formattedWeight}</span
        >
      </div>
    </div>
  </div>
  <div class="p-gs-4 flex-grow flex flex-col">
    <h3
      class="text-gs-h5 font-bold m-0 mb-gs-4 text-gs-institutional-green font-gs-primary leading-tight"
    >
      {title}
    </h3>
    {
      isOwned && (
        <div
          class="flex items-center gap-gs-2 mb-gs-3 px-gs-3 py-gs-2 bg-gs-success-emerald/10 rounded-md border-l-[3px] border-gs-success-emerald"
          aria-label={ownedBadgeLabel}
        >
          <span class="w-2 h-2 bg-gs-success-emerald rounded-full shrink-0 shadow-[0_0_6px_var(--gs-success-emerald)]" />
          <span class="text-gs-xs font-semibold text-gs-institutional-green uppercase tracking-[0.02em] leading-tight">
            {ownershipDeclaration}
          </span>
        </div>
      )
    }
    <div class="mt-auto flex justify-between items-end">
      <p class="text-gs-sm text-gs-slate-gray m-0 font-medium">{model}</p>
      <div class="flex flex-col items-end font-gs-mono">
        <span class="text-[0.7rem] uppercase tracking-widest text-gs-secondary"
          >{t("machinery.weight", lang)}</span
        >
        <span class="text-gs-base font-bold text-gs-text-primary"
          >{formattedWeight}</span
        >
      </div>
    </div>
  </div>
</a>
