---
/**
 * PROJECT CARD COMPONENT
 * ====================
 *
 * "Data Hero" card pattern for project gallery.
 * Features: Large MW capacity display, GSStamp for verified projects,
 * technical metadata (location, terrain), high-contrast styling.
 */
import { Image } from "astro:assets";
import GSStamp from "./GSStamp.astro";
import { t, translateTerrain } from "../utils/i18n-helpers";

interface Props {
  title: string;
  capacityMW: number;
  location: string;
  terrainType: string;
  heroImage: ImageMetadata;
  slug: string;
  lang: "bg" | "en";
  isVerified?: boolean;
}

const {
  title,
  capacityMW,
  location,
  terrainType,
  heroImage,
  slug,
  lang,
  isVerified = false,
} = Astro.props;

// Helper: Format Capacity Logic
const formatCapacity = (mw: number) => {
  if (mw < 1) {
    return { value: Math.round(mw * 1000), unit: "kWp" };
  }
  return { value: parseFloat(mw.toFixed(2)), unit: "MW" };
};

const { value: capacityValue, unit: capacityUnitLabel } =
  formatCapacity(capacityMW);

const url = `/${lang}/projects/${slug}`;
const terrainLabel = t("technical.terrain", lang);
const locationLabel = t("technical.location", lang);
const terrainValue = translateTerrain(terrainType, lang);
const verifiedLabel = t("technical.verifiedProject", lang);
---

<a
  href={url}
  class="group flex flex-col bg-gs-executive-white border border-gs-slate-gray/20 rounded-xl overflow-hidden no-underline text-gs-text-primary transition-all duration-400 ease-[cubic-bezier(0.165,0.84,0.44,1)] h-full relative hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,78,59,0.12)] hover:border-gs-institutional-green focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-gs-institutional-green"
  aria-label={`${title} - ${capacityValue} ${capacityUnitLabel}`}
  data-terrain={terrainType}
  data-capacity={capacityMW}
>
  <div class="relative w-full aspect-video overflow-hidden bg-gs-slate-gray">
    <Image
      src={heroImage}
      alt={title}
      width={800}
      widths={[400, 600, 800]}
      sizes="(min-width: 1920px) 25vw, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      quality={50}
      class="w-full h-full object-cover transition-transform duration-600 ease-[cubic-bezier(0.165,0.84,0.44,1)] group-hover:scale-105"
    />
    {
      isVerified && (
        <div
          class="absolute top-gs-3 right-gs-3 z-10 transition-transform duration-300 group-hover:rotate-[10deg] group-hover:scale-110"
          title={verifiedLabel}
        >
          <GSStamp size={70} />
        </div>
      )
    }
  </div>

  <div class="p-gs-5 flex-grow flex flex-col">
    <!-- Data Hero: MW/kWp Capacity -->
    <div class="flex items-baseline gap-gs-1 mb-gs-3">
      <span
        class="text-[2.75rem] md:text-[3rem] font-bold text-gs-institutional-green leading-none -tracking-[0.02em] font-gs-mono"
        >{capacityValue}</span
      >
      <span
        class="text-gs-h4 font-semibold text-gs-slate-gray uppercase tracking-widest font-gs-mono"
        >{capacityUnitLabel}</span
      >
    </div>

    <h3
      class="text-gs-h4 font-bold m-0 mb-gs-4 text-gs-text-primary font-gs-primary leading-tight"
    >
      {title}
    </h3>

    <!-- Technical Metadata -->
    <div
      class="mt-auto flex flex-col gap-gs-2 pt-gs-3 border-t border-gs-slate-gray/20"
    >
      <div class="flex justify-between items-start gap-gs-4">
        <span
          class="text-gs-xs uppercase tracking-widest text-gs-slate-gray font-medium shrink-0 mt-[2px]"
          >{locationLabel}</span
        >
        <span
          class="text-gs-sm text-gs-text-primary font-semibold text-right leading-relaxed"
          >{location}</span
        >
      </div>
      <div class="flex justify-between items-start gap-gs-4">
        <span
          class="text-gs-xs uppercase tracking-widest text-gs-slate-gray font-medium shrink-0 mt-[2px]"
          >{terrainLabel}</span
        >
        <span
          class="text-gs-sm text-gs-text-primary font-semibold text-right leading-relaxed"
          >{terrainValue}</span
        >
      </div>
    </div>
  </div>
</a>
