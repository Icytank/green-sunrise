---
/**
 * PROJECT FILTERS COMPONENT
 * ========================
 *
 * Client-side filtering for project gallery.
 * Zero-lag instant filtering without page reloads.
 */

interface Props {
  lang: "bg" | "en";
  terrainTypes: string[];
}

const { lang, terrainTypes } = Astro.props;

// Translations
const t = {
  bg: {
    allTerrain: "Всички терени",
    terrain: "Терен",
    capacity: "Капацитет",
    allCapacity: "Всички",
    microScale: "< 100 kWp",
    smallScale: "100 - 500 kWp",
    mediumScale: "500 kWp - 1 MW",
    largeScale: "> 1 MW",
    clearFilters: "Изчисти филтрите",
  },
  en: {
    allTerrain: "All Terrain",
    terrain: "Terrain",
    capacity: "Capacity",
    allCapacity: "All",
    microScale: "< 100 kWp",
    smallScale: "100 - 500 kWp",
    mediumScale: "500 kWp - 1 MW",
    largeScale: "> 1 MW",
    clearFilters: "Clear Filters",
  },
};

const labels = t[lang];
---

<div
  class="flex flex-wrap gap-gs-4 items-end mb-gs-8 p-gs-4 bg-gs-executive-white border border-gs-slate-gray/20 rounded-lg sm:flex-row flex-col sm:items-end items-stretch"
  id="project-filters"
>
  <!-- Terrain Filter -->
  <div class="flex flex-col gap-gs-1 min-w-[160px] flex-1 sm:flex-none">
    <label
      class="text-gs-xs uppercase tracking-widest text-gs-slate-gray font-bold"
      for="terrain-filter">{labels.terrain}</label
    >
    <select
      id="terrain-filter"
      class="p-gs-2 border border-gs-slate-gray/20 rounded-md bg-white text-gs-sm text-gs-text-primary cursor-pointer transition-all duration-200 hover:border-gs-institutional-green focus:outline-none focus:border-gs-institutional-green focus:ring-2 focus:ring-gs-institutional-green/15"
      aria-label={labels.terrain}
    >
      <option value="">{labels.allTerrain}</option>
      {terrainTypes.map((type) => <option value={type}>{type}</option>)}
    </select>
  </div>

  <!-- Capacity Filter -->
  <div class="flex flex-col gap-gs-1 min-w-[160px] flex-1 sm:flex-none">
    <label
      class="text-gs-xs uppercase tracking-widest text-gs-slate-gray font-bold"
      for="capacity-filter">{labels.capacity}</label
    >
    <select
      id="capacity-filter"
      class="p-gs-2 border border-gs-slate-gray/20 rounded-md bg-white text-gs-sm text-gs-text-primary cursor-pointer transition-all duration-200 hover:border-gs-institutional-green focus:outline-none focus:border-gs-institutional-green focus:ring-2 focus:ring-gs-institutional-green/15 font-gs-mono"
      aria-label={labels.capacity}
    >
      <option value="">{labels.allCapacity}</option>
      <option value="micro">{labels.microScale}</option>
      <option value="small">{labels.smallScale}</option>
      <option value="medium">{labels.mediumScale}</option>
      <option value="large">{labels.largeScale}</option>
    </select>
  </div>

  <!-- Clear Filters -->
  <button
    id="clear-filters"
    class="ml-auto px-gs-4 py-gs-2 border border-gs-slate-gray/20 rounded-md bg-transparent text-gs-sm text-gs-slate-gray cursor-pointer transition-all duration-200 hover:border-gs-institutional-green hover:text-gs-institutional-green disabled:opacity-50 disabled:cursor-not-allowed group"
    type="button"
    aria-label={labels.clearFilters}
  >
    {labels.clearFilters}
  </button>
</div>

<script>
  function initFilters() {
    const terrainFilter = document.getElementById(
      "terrain-filter",
    ) as HTMLSelectElement;
    const capacityFilter = document.getElementById(
      "capacity-filter",
    ) as HTMLSelectElement;
    const clearBtn = document.getElementById("clear-filters");
    // Map project-card to a constant class for JS hook
    const projectCards = document.querySelectorAll(
      "a[data-terrain]",
    ) as NodeListOf<HTMLElement>;

    if (!terrainFilter || !capacityFilter || !clearBtn) return;

    function filterProjects() {
      const terrain = terrainFilter.value;
      const capacity = capacityFilter.value;

      projectCards.forEach((card) => {
        const cardTerrain = card.dataset.terrain || "";
        const cardCapacity = parseFloat(card.dataset.capacity || "0");

        let terrainMatch = !terrain || cardTerrain === terrain;
        let capacityMatch = true;

        if (capacity === "micro") {
          capacityMatch = cardCapacity < 0.1; // < 100 kWp
        } else if (capacity === "small") {
          capacityMatch = cardCapacity >= 0.1 && cardCapacity < 0.5; // 100-500 kWp
        } else if (capacity === "medium") {
          capacityMatch = cardCapacity >= 0.5 && cardCapacity <= 1.0; // 500-1MW
        } else if (capacity === "large") {
          capacityMatch = cardCapacity > 1.0; // > 1 MW
        }

        if (terrainMatch && capacityMatch) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });

      updateActiveStates();
    }

    function updateActiveStates() {
      const hasActiveFilter = !!(terrainFilter.value || capacityFilter.value);

      if (hasActiveFilter) {
        clearBtn!.classList.add(
          "bg-gs-institutional-green",
          "text-white",
          "border-gs-institutional-green",
        );
        clearBtn!.classList.remove(
          "bg-transparent",
          "text-gs-slate-gray",
          "border-gs-slate-gray/20",
        );
      } else {
        clearBtn!.classList.remove(
          "bg-gs-institutional-green",
          "text-white",
          "border-gs-institutional-green",
        );
        clearBtn!.classList.add(
          "bg-transparent",
          "text-gs-slate-gray",
          "border-gs-slate-gray/20",
        );
      }

      [terrainFilter, capacityFilter].forEach((select) => {
        if (select.value) {
          select.classList.add(
            "border-gs-institutional-green",
            "bg-gs-institutional-green/5",
            "text-gs-institutional-green",
            "font-bold",
          );
        } else {
          select.classList.remove(
            "border-gs-institutional-green",
            "bg-gs-institutional-green/5",
            "text-gs-institutional-green",
            "font-bold",
          );
        }
      });
    }

    function clearFilters() {
      terrainFilter.value = "";
      capacityFilter.value = "";
      filterProjects();
    }

    terrainFilter.addEventListener("change", filterProjects);
    capacityFilter.addEventListener("change", filterProjects);
    clearBtn.addEventListener("click", clearFilters);

    // Initial state
    updateActiveStates();
  }

  initFilters();
  document.addEventListener("astro:after-swap", initFilters);
</script>
