---
import { t, type TranslationKey } from "src/utils/i18n-helpers";
import IconCard from "./IconCard.astro";

interface Props {
    lang: "bg" | "en";
}

const { lang } = Astro.props;

const tr = (key: string) =>
    t(`projects.methodology.steps.${key}` as TranslationKey, lang);

const steps = [
    { key: "adherence", icon: "📋" },
    { key: "precision", icon: "🎯" },
    { key: "coordination", icon: "🔄" },
    { key: "efficiency", icon: "⚡" },
    { key: "safety", icon: "🛡️" },
];
---

<section id="methodology" class="pb-gs-section-padding-y bg-gs-executive-white">
    <div class="w-full max-w-[1280px] mx-auto flex flex-col gap-gs-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-gs-6">
            {
                steps.map((step, index) => (
                    <IconCard
                        icon={step.icon}
                        title={tr(`${step.key}.title`)}
                        description={tr(`${step.key}.desc`)}
                        class="relative"
                    >
                        <span
                            slot="header-extras"
                            class="absolute top-gs-3 right-gs-3 bg-gs-institutional-green text-white text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center border-2 border-white shadow-sm"
                        >
                            {index + 1}
                        </span>
                    </IconCard>
                ))
            }
        </div>
    </div>
</section>
