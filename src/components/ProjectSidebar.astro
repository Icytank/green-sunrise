---
/**
 * PROJECT SIDEBAR COMPONENT
 * ========================
 *
 * Technical specifications sidebar for project detail page.
 * Features: MW capacity, terrain, location, verification status with GSStamp.
 */
import GSStamp from "./GSStamp.astro";
import { t, translateTerrain } from "../utils/i18n-helpers";

interface Props {
  capacityMW: number;
  terrainType: string;
  location: string;
  isVerified: boolean;
  lang: "bg" | "en";
  scope?: string;
}

const { capacityMW, terrainType, location, isVerified, lang, scope } =
  Astro.props;

// Use centralized translations
const capacityLabel = t("technical.capacity", lang);
const terrainLabel = t("technical.terrain", lang);
const locationLabel = t("technical.location", lang);
const scopeLabel = t("projects.detail.scope" as any, lang);
// const capacityUnit = t('technical.capacityUnit', lang); // Replaced by smart unit
const terrainValue = translateTerrain(terrainType, lang);
const verifiedTitle = t("technical.verifiedProject", lang);
const verifiedDesc = t("technical.verifiedDesc", lang);
const technicalSpecsTitle = t("technical.specsTitle", lang);

// Helper: Format Capacity Logic
const formatCapacity = (mw: number) => {
  if (mw < 1) {
    return { value: Math.round(mw * 1000), unit: "kWp" };
  }
  return { value: parseFloat(mw.toFixed(2)), unit: "MW" };
};

const { value: capacityValue, unit: capacityUnitLabel } =
  formatCapacity(capacityMW);
---

<aside
  class="bg-gs-executive-white border-y md:border border-gs-slate-gray/20 rounded-none md:rounded-xl p-gs-4 md:p-gs-6"
>
  <h2
    class="text-gs-h5 font-bold text-gs-institutional-green m-0 mb-gs-5 pb-gs-3 border-b-2 border-gs-institutional-green font-gs-primary uppercase tracking-wider"
  >
    {technicalSpecsTitle}
  </h2>

  <dl class="flex flex-col gap-gs-4 m-0 p-0">
    <!-- Capacity (Primary Data Point) -->
    <div
      class="bg-gs-institutional-green/5 p-gs-4 rounded-lg border-l-4 border-gs-institutional-green flex flex-col gap-gs-1"
    >
      <dt
        class="text-gs-xs uppercase tracking-[0.08em] text-gs-slate-gray font-bold"
      >
        {capacityLabel}
      </dt>
      <dd
        class="text-gs-h3 text-gs-institutional-green font-bold leading-tight font-gs-mono m-0"
      >
        {capacityValue}
        <span class="text-gs-h5 text-gs-slate-gray font-normal lowercase"
          >{capacityUnitLabel}</span
        >
      </dd>
    </div>

    <!-- Terrain -->
    <div class="flex flex-col gap-gs-1 px-gs-1">
      <dt
        class="text-gs-xs uppercase tracking-[0.08em] text-gs-slate-gray font-bold"
      >
        {terrainLabel}
      </dt>
      <dd class="text-gs-base text-gs-text-primary font-bold m-0">
        {terrainValue}
      </dd>
    </div>

    <!-- Location -->
    <div class="flex flex-col gap-gs-1 px-gs-1">
      <dt
        class="text-gs-xs uppercase tracking-[0.08em] text-gs-slate-gray font-bold"
      >
        {locationLabel}
      </dt>
      <dd class="text-gs-base text-gs-text-primary font-bold m-0">
        {location}
      </dd>
    </div>

    <!-- Scope of Work -->
    {
      scope && (
        <div class="flex flex-col gap-gs-1 px-gs-1">
          <dt class="text-gs-xs uppercase tracking-[0.08em] text-gs-slate-gray font-bold">
            {scopeLabel}
          </dt>
          <dd class="text-gs-base text-gs-text-primary font-bold m-0">
            {scope}
          </dd>
        </div>
      )
    }
  </dl>

  <!-- Verification Status -->
  {
    isVerified && (
      <div class="mt-gs-6 pt-gs-5 border-t border-gs-slate-gray/20 flex items-center gap-gs-3">
        <GSStamp size={80} />
        <div class="flex flex-col gap-gs-1">
          <span class="text-gs-sm font-bold text-gs-success-emerald uppercase tracking-wider">
            {verifiedTitle}
          </span>
          <span class="text-gs-xs text-gs-slate-gray leading-relaxed">
            {verifiedDesc}
          </span>
        </div>
      </div>
    )
  }
</aside>
