---
import GSStamp from "./GSStamp.astro";

interface Props {
  label: string;
  title: string;
  description?: string;
  align?: "left" | "center" | "right";
  withStamp?: boolean;
  titleColor?: string;
}

const {
  label,
  title,
  description,
  align = "left",
  withStamp = true,
  titleColor = "text-gs-institutional-green",
} = Astro.props;

const alignmentClasses = {
  left: "items-start text-left",
  center: "items-center text-center",
  right: "items-end text-right",
};
---

<div
  class:list={[
    "w-full mb-gs-4 relative flex flex-col gap-gs-2",
    alignmentClasses[align],
  ]}
  data-aos="fade-up"
>
  {
    withStamp && (
      <div class="absolute -top-[20px] right-0 z-[-1] opacity-10 rotate-[15deg] md:right-[-40px] md:opacity-15">
        <GSStamp size={60} />
      </div>
    )
  }
  <span
    class="text-gs-sm font-bold uppercase tracking-widest text-gs-secondary block mb-1"
    >{label}</span
  >
  <h2
    class:list={[
      "text-[clamp(1.9375rem,3.9vw,3.0625rem)] font-black leading-tight m-0 max-w-[800px]",
      titleColor,
    ]}
  >
    {title}
  </h2>
  {
    description && (
      <p class="text-gs-base leading-relaxed text-gs-slate-gray max-w-[650px] m-0">
        {description}
      </p>
    )
  }
  <slot />
</div>
