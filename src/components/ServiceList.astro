---
import { t, type TranslationKey } from "src/utils/i18n-helpers";
import SectionHeader from "./SectionHeader.astro";
import IconCard from "./IconCard.astro";

interface Props {
    lang: "bg" | "en";
}

const { lang } = Astro.props;

const tr = (key: string) => t(`services.list.${key}` as TranslationKey, lang);

const services = [
    { key: "pileDriving", icon: "🔩" },
    { key: "structureInstallation", icon: "🏗️" },
    { key: "moduleInstallation", icon: "☀️" },
    { key: "epcSupport", icon: "🤝" },
    { key: "labourTeams", icon: "👷" },
];
---

<section
    id="services-list"
    class="py-gs-section-padding-y bg-gs-surface-secondary"
>
    <div class="w-full max-w-[1280px] mx-auto px-4">
        <SectionHeader
            label={t("nav.services" as TranslationKey, lang)}
            title={t("services.title" as TranslationKey, lang)}
            description=""
            align="left"
        />

        <div
            class="w-full p-0 m-0 grid grid-cols-12 gap-gs-4 lg:flex lg:flex-wrap lg:justify-center"
        >
            {
                services.map((s) => (
                    <div class="col-span-12 md:col-span-6 lg:w-[calc(33.33%-var(--spacing-gs-4))] lg:max-w-[400px]">
                        <IconCard
                            icon={s.icon}
                            title={tr(`${s.key}.title`)}
                            description={tr(`${s.key}.desc`)}
                            class="h-full"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
