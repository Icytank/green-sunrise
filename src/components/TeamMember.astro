---
import { Image } from "astro:assets";
import GSStamp from "./GSStamp.astro";
import { formatExperience, processCertifications } from "./TeamMember.logic";
import type { TeamMemberProps } from "./TeamMember.logic";
import { t } from "../utils/i18n-helpers";

interface Props extends TeamMemberProps {
    avatar: ImageMetadata;
    animationDelay?: number;
}

const {
    name,
    role,
    certifications,
    yearsExperience,
    verified,
    lang,
    avatar,
    animationDelay = 0,
} = Astro.props;

const formattedExperience = formatExperience(yearsExperience);
const filteredCertifications = processCertifications(certifications);
---

<div
    class="bg-white border border-gs-slate-gray/20 p-4 sm:p-gs-3 flex flex-col gap-gs-3 h-full transition-all duration-300 relative hover:-translate-y-1 hover:shadow-[0_12px_24px_rgba(6,78,59,0.1)] hover:border-gs-institutional-green rounded-xl"
    data-aos="fade-up"
    data-aos-delay={animationDelay}
    data-aos-anchor-placement="center-bottom"
>
    <div
        class="relative w-full aspect-square overflow-hidden bg-gs-slate-gray border border-gs-slate-gray/10 rounded-lg"
    >
        <Image
            src={avatar}
            alt={name}
            width={400}
            height={400}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
        />
        {
            verified && (
                <div
                    class="absolute -top-[10px] -right-[10px] z-[2] -rotate-[5deg] drop-shadow-md"
                    title={t("team.verifiedProfile", lang)}
                    aria-label={t("team.verifiedProfile", lang)}
                >
                    <GSStamp size={60} />
                </div>
            )
        }
    </div>
    <div class="flex flex-col gap-gs-1 text-left px-1">
        <h3
            class="text-gs-h5 font-bold text-gs-institutional-green m-0 leading-tight"
        >
            {name}
        </h3>
        <p
            class="text-gs-xs font-bold text-gs-slate-gray uppercase tracking-[0.1em] m-0"
        >
            {role}
        </p>
        <div class="mt-gs-1 text-gs-sm flex gap-gs-1 items-center">
            <span class="font-bold text-gs-text-primary"
                >{t("team.experience", lang)}:</span
            >
            <span class="text-gs-slate-gray font-gs-mono"
                >{formattedExperience} {t("team.yearsSuffix", lang)}</span
            >
        </div>
        {
            filteredCertifications.length > 0 && (
                <div class="mt-gs-2 pt-gs-2 border-t border-gs-slate-gray/20">
                    <h4 class="text-gs-xs font-extrabold uppercase text-gs-institutional-green mb-gs-1 font-gs-primary">
                        {t("team.certifications", lang)}
                    </h4>
                    <ul class="list-none p-0 m-0 flex flex-col gap-[6px]">
                        {filteredCertifications.map((cert) => (
                            <li class="text-gs-xs leading-tight text-gs-text-primary relative pl-[14px] font-medium before:content-['•'] before:absolute before:left-0 before:text-gs-success-emerald before:font-bold">
                                {cert}
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }
    </div>
</div>
