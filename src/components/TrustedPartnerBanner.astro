---
import { t, type TranslationKey } from "src/utils/i18n-helpers";

interface Props {
  lang: "bg" | "en";
}

const { lang } = Astro.props;

const text = t("home.trustedPartner.text" as TranslationKey, lang);
---

<section
  id="trusted-partner"
  class="py-gs-4 bg-gs-executive-white border-t border-gs-slate-gray/20"
>
  <div
    class="w-full max-w-[1280px] mx-auto px-4 flex justify-center items-center"
  >
    <p
      class="text-gs-h4 font-semibold text-gs-secondary tracking-[0.05em] uppercase text-center m-0"
    >
      {text}
    </p>
  </div>
</section>
