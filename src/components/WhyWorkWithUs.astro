---
import { t, type TranslationKey } from "src/utils/i18n-helpers";
import SectionHeader from "./SectionHeader.astro";

interface Props {
    lang: "bg" | "en";
}

const { lang } = Astro.props;

const tr = (key: string) => t(`services.whyUs.${key}` as TranslationKey, lang);

const reasons = [
    "specialized",
    "machinery",
    "agility",
    "quality",
    "partnership",
];
---

<section
    id="why-us"
    class="py-gs-section-padding-y bg-gs-institutional-green text-white"
>
    <div class="w-full max-w-[1280px] mx-auto px-4">
        <div class="cs-content">
            <SectionHeader
                label=""
                title={tr("title")}
                description=""
                align="left"
                titleColor="text-white"
                data-aos="fade-up"
            />

            <ul
                class="m-0 mt-gs-6 p-0 list-none grid grid-cols-1 md:grid-cols-2 gap-gs-6"
            >
                {
                    reasons.map((r, index) => (
                        <li
                            class="flex gap-gs-4 items-start"
                            data-aos="fade-up"
                            data-aos-delay={index * 100}
                        >
                            <span class="text-[1.5rem] font-bold text-gs-success-emerald bg-white/10 w-8 h-8 rounded-full flex items-center justify-center shrink-0">
                                ✓
                            </span>
                            <div class="cs-item-content">
                                <strong class="block text-gs-h5 font-bold mb-gs-1 text-white">
                                    {tr(`list.${r}.title`)}
                                </strong>
                                <p class="text-gs-base text-white/80 leading-gs-leading-body m-0">
                                    {tr(`list.${r}.desc`)}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
