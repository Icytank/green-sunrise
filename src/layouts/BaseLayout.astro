---
// Utils
import { ClientRouter } from "astro:transitions";
import type { GetImageResult } from "astro";
import "@styles/tokens.css";
import "@styles/global.css";

import "@fontsource-variable/inter";
import "@fontsource/geist-mono";

// Asset URLs for preloading
import interFontUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import geistFontUrl from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";

// Components
import DynamicHeader from "@components/Header/DynamicHeader.astro";
import Footer from "@components/Footer/Footer.astro";
import Meta from "@components/Meta/Meta.astro";

// Data
import { SITE } from "@data/client";

// Create a union type for heroImage
type HeroImage = GetImageResult | ImageMetadata;

interface Props {
	title: string;
	description: string;
	lang?: string;
	heroImage?: HeroImage; // optional - passing a heroImage to BaseLayout will 1. preload the image and 2. use the image for og socials tags in the <head>
	ogType?: string;
	alternateLinks?: { lang: string; href: string }[];
	removeBottomPadding?: boolean;
}

const {
	description,
	title,
	heroImage,
	lang = "bg",
	ogType,
	alternateLinks,
	removeBottomPadding = false,
} = Astro.props as Props;

// Smart default for alternate links if not provided (assumes symmetric URL structure)
let finalAlternateLinks = alternateLinks;
if (!finalAlternateLinks) {
	const currentPath = Astro.url.pathname;
	// Remove trailing slash for consistency check, but preserve for replacement if needed,
	// although Astro usually normalizes.

	// Check if path starts with /bg or /en
	if (lang === "bg" && currentPath.startsWith("/bg")) {
		finalAlternateLinks = [
			{
				lang: "en",
				href: Astro.url.origin + currentPath.replace("/bg", "/en"),
			},
		];
	} else if (lang === "en" && currentPath.startsWith("/en")) {
		finalAlternateLinks = [
			{
				lang: "bg",
				href: Astro.url.origin + currentPath.replace("/en", "/bg"),
			},
		];
	}
}
---

<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<!-- View Transitions support -->
		<ClientRouter />

		<!-- SEO Meta Tags -->
		<Meta
			title={title}
			description={description}
			heroImage={heroImage}
			lang={lang}
			ogType={ogType}
			alternateLinks={finalAlternateLinks}
		>
			<slot name="schema" slot="schema" />
		</Meta>

		<!-- Fonts (Self-hosted via @fontsource) -->
		<!-- Optimization: Eliminates blocking round-trips to fonts.googleapis.com -->
		<!-- Preload critical fonts -->
		<link
			rel="preload"
			href={interFontUrl}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={geistFontUrl}
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<!-- If present, preloads the image passed as a prop -->
		{
			heroImage && (
				<link
					rel="preload"
					as="image"
					href={heroImage.src}
					imagesrcset={
						"srcSet" in heroImage
							? heroImage.srcSet.attribute
							: undefined
					}
					imagesizes={
						"attributes" in heroImage
							? heroImage.attributes.sizes
							: undefined
					}
				/>
			)
		}

		<!-- Sitewide Scripts -->
		<script src="@utils/nav.ts"></script>
		<script>
			import { initAOS } from "@utils/aos";

			// Initialize AOS on every page load
			document.addEventListener("astro:page-load", () => {
				initAOS();
			});

			// Fix for View Transitions: Remove AOS classes before swap to force re-animation
			document.addEventListener("astro:after-swap", () => {
				const elements = document.querySelectorAll("[data-aos]");
				elements.forEach((el) => {
					el.classList.remove("aos-animate");
				});
			});
		</script>
	</head>
	<body
		class="m-0 p-0 font-gs-primary bg-gs-executive-white text-gs-text-primary overflow-x-hidden antialiased selection:bg-gs-institutional-green selection:text-white"
	>
		<!-- Screen reader skip main nav -->
		<a
			class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[10001] focus:p-4 focus:bg-gs-success-emerald focus:text-white focus:font-bold focus:no-underline focus:outline-none focus:ring-2 focus:ring-gs-success-emerald focus:ring-offset-2 transition-transform duration-300"
			aria-label="skip to main content"
			href="#main">Click To Skip To Main Content</a
		>

		<DynamicHeader lang={lang} />
		<main
			id="main"
			class:list={[
				"relative z-1 isolation-auto pt-gs-header-height",
				!removeBottomPadding && "pb-gs-8 md:pb-gs-12",
			]}
		>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
