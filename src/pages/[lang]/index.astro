---
export const prerender = true;
export function getStaticPaths() {
	return [{ params: { lang: "bg" } }, { params: { lang: "en" } }];
}
const { lang } = Astro.params;

// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHero from "@components/HomeHero.astro";
import SectionHeader from "@components/SectionHeader.astro";
import MachineryCard from "@components/MachineryCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import TeamMember from "@components/TeamMember.astro";
import Button from "@components/Button.astro";
import CTASimple from "@components/CTA/CTASimple.astro";
import HomeAdvantages from "@components/HomeAdvantages.astro";
import TrustedPartnerBanner from "@components/TrustedPartnerBanner.astro";

// Optimization: Ensure high priority for LCP
import heroImage from "@assets/images/home-hero.png";
const optimizedHeroImage = await getImage({
	src: heroImage,
	format: "webp",
	quality: 40,
	width: 1920,
	height: 1080,
	widths: [360, 720, 1300, 1920],
	sizes: "100vw",
	fit: "cover",
	position: "center",
});

// Data Fetching
import { getCollection } from "astro:content";
import { t } from "src/utils/i18n-helpers";

// Fetch collections based on language
// Note: We filter by ID starting with lang because typically localized content is in subfolders like src/content/machinery/en/...
// Adjust filtering logic if your content structure differs (e.g. frontmatter lang field)
const allMachinery = await getCollection("machinery", ({ id }) =>
	id.startsWith(`${lang}/`),
);
const allProjects = await getCollection("projects", ({ id }) =>
	id.startsWith(`${lang}/`),
);
const allTeam = await getCollection("teams", ({ id }) =>
	id.startsWith(`${lang}/`),
);

// Sort by capacityMW descending and slice top 3
const projectsPreview = allProjects
	.sort((a, b) => (b.data.capacityMW || 0) - (a.data.capacityMW || 0))
	.slice(0, 3);

const teamPreview = allTeam.slice(0, 4); // 4 looks good in grid

// Sort/Slice for Preview
// Assuming we want to show 3 of each or specific "featured" logic.
// For now, taking first 3.
const machineryPreview = allMachinery.slice(0, 3);

// Translation Helpers
const translate = (key: string) => t(`home.${key}` as any, lang);
---

<BaseLayout
	lang={lang as "bg" | "en"}
	title={translate("pageTitle")}
	description={translate("pageDescription")}
	heroImage={optimizedHeroImage}
>
	<HomeHero lang={lang as "bg" | "en"} heroImage={heroImage} />

	<!-- ADVANTAGES SECTION -->
	<HomeAdvantages lang={lang as "bg" | "en"} />

	<!-- PROJECTS SECTION -->
	<section id="projects" class="py-gs-section-padding-y px-4">
		<div class="w-full max-w-[1280px] mx-auto">
			<SectionHeader
				label={translate("projectsLabel")}
				title={translate("projectsTitle")}
				description={translate("projectsDesc")}
				align="center"
				withStamp={false}
			/>
			<ul
				class="p-0 m-0 list-none flex flex-wrap justify-center gap-gs-4"
			>
				{
					projectsPreview.map((item, index) => (
						<li class="w-full md:w-[calc((100%-var(--spacing-gs-4))/2)] lg:w-[calc((100%-2*var(--spacing-gs-4))/3)]">
							<ProjectCard
								slug={
									item.data.custom_slug ||
									item.id
										.split("/")
										.pop()!
										.replace(/\.[^/.]+$/, "")
								}
								lang={lang as "bg" | "en"}
								{...item.data}
								animationDelay={index * 100}
							/>
						</li>
					))
				}
			</ul>
			<div class="mt-gs-4 text-center">
				<Button href={`/${lang}/projects`} variant="outline"
					>{translate("viewAll")}</Button
				>
			</div>
		</div>
	</section>

	<!-- MACHINERY SECTION -->
	<section id="machinery" class="py-gs-section-padding-y px-4">
		<div class="w-full max-w-[1280px] mx-auto">
			<SectionHeader
				label={translate("machineryLabel")}
				title={translate("machineryTitle")}
				description={translate("machineryDesc")}
				align="center"
				withStamp={false}
			/>
			<ul
				class="p-0 m-0 list-none flex flex-wrap justify-center gap-gs-4"
			>
				{
					machineryPreview.map((item, index) => (
						<li class="w-full md:w-[calc((100%-var(--spacing-gs-4))/2)] lg:w-[calc((100%-2*var(--spacing-gs-4))/3)]">
							<MachineryCard
								slug={
									item.data.custom_slug ||
									item.id
										.split("/")
										.pop()!
										.replace(/\.[^/.]+$/, "")
								}
								lang={lang as "bg" | "en"}
								{...item.data}
								image={item.data.heroImage}
								animationDelay={index * 100}
							/>
						</li>
					))
				}
			</ul>
			<div class="mt-gs-4 text-center">
				<Button href={`/${lang}/machinery`} variant="outline"
					>{translate("viewAll")}</Button
				>
			</div>
		</div>
	</section>

	<!-- TEAM SECTION -->
	<section
		id="team"
		class="py-gs-section-padding-y px-4 bg-gs-executive-white text-center"
	>
		<!-- Centered align for Team -->
		<div class="w-full max-w-[1280px] mx-auto">
			<SectionHeader
				label={translate("teamLabel")}
				title={translate("teamTitle")}
				description={translate("teamDesc")}
				align="center"
				withStamp={false}
			/>
			<ul
				class="p-0 m-0 list-none flex flex-wrap justify-center gap-gs-4"
			>
				<!-- 4 cols for team -->
				{
					teamPreview.map((item, index) => (
						<li class="w-full sm:w-[calc((100%-var(--spacing-gs-4))/2)] lg:w-[calc((100%-3*var(--spacing-gs-4))/4)]">
							<TeamMember
								lang={lang as "bg" | "en"}
								{...item.data}
								animationDelay={index * 100}
							/>
						</li>
					))
				}
			</ul>
			<!-- View All Team? Maybe just About Us link -->
			<div class="mt-gs-4 text-center pb-8">
				<Button href={`/${lang}/about`} variant="outline"
					>{translate("viewAll")}</Button
				>
			</div>
		</div>
	</section>

	<CTASimple lang={lang as "bg" | "en"} />

	<TrustedPartnerBanner lang={lang as "bg" | "en"} />
</BaseLayout>
