---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

// Force static generation for this route
export const prerender = true;
import { Image, getImage } from "astro:assets";
import GSStamp from "../../../components/GSStamp.astro";
import { t } from "../../../utils/i18n-helpers";

// Generate paths for all machinery items
export async function getStaticPaths() {
  const machinery = await getCollection("machinery");
  return machinery.map((item) => {
    const parts = item.id.split("/");
    if (parts.length < 2) {
      throw new Error(
        `Invalid machinery ID format: ${item.id}. Expected lang/slug.`,
      );
    }
    const lang = parts[0];
    let slug = parts.slice(1).join("/").replace(/\.md$/, "");

    // Decouple URL from filename: use custom_slug if present
    if (item.data.custom_slug) {
      slug = item.data.custom_slug;
    }

    return {
      params: { lang, slug },
      props: { item },
    };
  });
}

const { item } = Astro.props;
const { lang } = Astro.params;
const {
  title,
  model,
  weight,
  impactPower,
  heroImage,
  galleryImages,
  isOwned = true,
} = item.data;
const { Content } = await render(item);
const ownedBadgeLabel = t("machinery.ownedBadge", lang as "bg" | "en");
const ownershipDeclaration = t(
  "machinery.ownershipDeclaration",
  lang as "bg" | "en",
);

// Pre-optimize hero image for lightbox
const optimizedHero = await getImage({
  src: heroImage,
  format: "webp",
  quality: 90,
  width: 1920,
});

// Pre-optimize gallery images for lightbox
const optimizedGallery = await Promise.all(
  (galleryImages || []).map(async (img) => {
    const optimized = await getImage({
      src: img,
      format: "webp",
      quality: 90,
      width: 1920,
    });
    return {
      original: img,
      src: optimized.src,
    };
  }),
);

console.log("DBUG: Machinery optimized sources:", [
  optimizedHero.src,
  ...optimizedGallery.map((i) => i.src),
]);
---

<BaseLayout
  lang={lang as "bg" | "en"}
  title={title || model}
  description={`Technical audit and specifications for ${model}`}
>
  <article class="pb-gs-10">
    <header
      class="bg-gs-executive-white py-gs-12 md:py-gs-10 pb-gs-8 md:pb-gs-6 mb-gs-6 border-b border-gs-slate-gray/20"
    >
      <div class="max-w-[1400px] mx-auto px-gs-2">
        <h1
          class="text-gs-h2 text-gs-institutional-green font-gs-primary m-0 font-bold"
        >
          {title}
        </h1>
        <p
          class="text-gs-slate-gray text-gs-h4 mt-gs-1 font-medium font-gs-mono"
        >
          {model}
        </p>
      </div>
    </header>

    <div
      class="max-w-[1400px] mx-auto px-gs-2 grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-gs-6 lg:gap-gs-8"
    >
      <!-- Left: Gallery -->
      <div class="gallery-section">
        <div class="relative rounded-xl overflow-hidden mb-gs-4 shadow-lg">
          <Image
            src={heroImage}
            alt={title}
            width={1200}
            class="w-full h-auto block cursor-zoom-in"
            data-full-src={optimizedHero.src}
          />
          {
            isOwned && (
              <div
                class="absolute bottom-gs-4 right-gs-4 z-10"
                title={ownedBadgeLabel}
                aria-label={ownedBadgeLabel}
              >
                <GSStamp size={100} />
              </div>
            )
          }
        </div>

        {
          optimizedGallery && optimizedGallery.length > 0 && (
            <div class="grid grid-cols-[repeat(auto-fill,minmax(100px,1fr))] gap-gs-2">
              {optimizedGallery.map((img, i) => (
                <Image
                  src={img.original}
                  alt={`${title} detail ${i + 1}`}
                  width={300}
                  class="w-full h-[100px] object-cover rounded-md cursor-zoom-in transition-opacity hover:opacity-80"
                  data-full-src={img.src}
                />
              ))}
            </div>
          )
        }
      </div>

      <!-- Right: Specs / Narrative -->
      <div class="info-section">
        <section class="mb-gs-4">
          <h2
            class="text-gs-h3 text-gs-text-primary mb-gs-4 border-l-4 border-gs-institutional-green pl-gs-2 font-bold"
          >
            {t("machinery.theMachine", lang as "bg" | "en")}
          </h2>
          <div class="leading-gs-leading-body text-gs-slate-gray text-gs-base">
            <Content />
          </div>
        </section>

        <section class="technical-specifications">
          <h2
            class="text-gs-h3 text-gs-text-primary mb-gs-4 border-l-4 border-gs-institutional-green pl-gs-2 font-bold"
          >
            {t("machinery.technicalSpecifications", lang as "bg" | "en")}
          </h2>
          <div class="specs-wrapper">
            <dl
              class="bg-gs-executive-white border border-gs-slate-gray/20 rounded-lg overflow-hidden font-mono"
            >
              <div
                class="flex justify-between p-gs-3 border-b border-gs-slate-gray/20"
              >
                <dt class="text-gs-secondary font-medium">
                  {t("machinery.model", lang as "bg" | "en")}
                </dt>
                <dd class="text-gs-text-primary font-bold">{model}</dd>
              </div>
              <div
                class="flex justify-between p-gs-3 border-b border-gs-slate-gray/20"
              >
                <dt class="text-gs-secondary font-medium">
                  {t("machinery.weight", lang as "bg" | "en")}
                </dt>
                <dd class="text-gs-text-primary font-bold">{weight}</dd>
              </div>
              {
                impactPower && (
                  <div class="flex justify-between p-gs-3 border-b border-gs-slate-gray/20 last:border-b-0">
                    <dt class="text-gs-secondary font-medium">
                      {t("machinery.impactPower", lang as "bg" | "en")}
                    </dt>
                    <dd class="text-gs-text-primary font-bold">
                      {impactPower}
                    </dd>
                  </div>
                )
              }
            </dl>
            {
              isOwned && (
                <div class="mt-gs-4 flex items-center gap-gs-3 p-gs-4 bg-gs-success-emerald/10 border border-gs-success-emerald border-l-4 rounded-lg">
                  <span class="w-3 h-3 bg-gs-success-emerald rounded-full shrink-0 shadow-[0_0_8px_var(--gs-success-emerald)]" />
                  <div class="flex items-center gap-gs-3">
                    <div class="shrink-0 opacity-90">
                      <GSStamp size={40} />
                    </div>
                    <p class="m-0 text-gs-sm text-gs-institutional-green font-bold uppercase tracking-wider">
                      {ownershipDeclaration}
                    </p>
                  </div>
                </div>
              )
            }
          </div>
        </section>
      </div>
    </div>
  </article>

  <!-- Lightbox Modal -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[1000] bg-gs-text-primary/95 flex items-center justify-center backdrop-blur-md hidden opacity-0 transition-opacity duration-300"
  >
    <span
      class="absolute top-[30px] right-[35px] text-white text-[60px] font-bold cursor-pointer hover:text-gs-success-emerald leading-none select-none close"
      >&times;</span
    >
    <img
      class="max-w-[90%] max-h-[90%] rounded-lg shadow-2xl scale-90 transition-transform duration-300 lightbox-content"
      id="lightbox-img"
    />
  </div>
</BaseLayout>

<script>
  function setupLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const closeBtn = document.querySelector(".close");
    const clickableImages = document.querySelectorAll(".cursor-zoom-in");

    clickableImages.forEach((img) => {
      img.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLImageElement;
        const fullSrc = target.getAttribute("data-full-src");
        if (fullSrc && lightbox && lightboxImg) {
          lightbox.classList.remove("hidden");
          // Small timeout to allow transition to trigger
          setTimeout(() => {
            lightbox.classList.add("opacity-100");
            lightboxImg.classList.add("scale-100");
            lightboxImg.classList.remove("scale-90");
          }, 10);
          lightboxImg.src = fullSrc;
          document.body.style.overflow = "hidden"; // Prevent scroll
        }
      });
    });

    const closeLightbox = () => {
      if (lightbox && lightboxImg) {
        lightbox.classList.remove("opacity-100");
        lightboxImg.classList.remove("scale-100");
        lightboxImg.classList.add("scale-90");
        setTimeout(() => {
          lightbox.classList.add("hidden");
        }, 300);
        document.body.style.overflow = "auto";
      }
    };

    closeBtn?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        lightbox &&
        !lightbox.classList.contains("hidden")
      ) {
        closeLightbox();
      }
    });
  }

  // Initialize lightbox on page load and after Astro transitions
  setupLightbox();
  document.addEventListener("astro:after-swap", setupLightbox);
</script>
