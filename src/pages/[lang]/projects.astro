---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ProjectFilters from "@components/ProjectFilters.astro";
import ProjectMethodology from "@components/ProjectMethodology.astro";
import { t, type TranslationKey } from "src/utils/i18n-helpers";

export const prerender = true;
export function getStaticPaths() {
  return [{ params: { lang: "bg" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;

// Query the projects collection filtered by language
const allProjects = await getCollection("projects", ({ id }) => {
  return id.startsWith(`${lang}/`);
});

// Sort by capacity (highest first) for impact
const sortedProjects = allProjects.sort(
  (a, b) => b.data.capacityMW - a.data.capacityMW,
);

// Extract unique terrain types for filter dropdown
const terrainTypes = [...new Set(allProjects.map((p) => p.data.terrainType))];
---

<BaseLayout
  lang={lang}
  title={t("projects.pageTitle" as TranslationKey, lang as "bg" | "en")}
  description={t(
    "projects.pageDescription" as TranslationKey,
    lang as "bg" | "en",
  )}
>
  <main class="min-h-screen bg-gs-executive-white py-gs-section-padding-y">
    <section class="max-w-[1400px] mx-auto px-gs-2 md:px-gs-4">
      <header class="text-center mb-[120px]">
        <h1
          class="text-gs-h1 text-gs-institutional-green font-bold mb-gs-3 font-gs-primary"
        >
          {t("projects.title" as TranslationKey, lang as "bg" | "en")}
        </h1>
        <p
          class="text-gs-h5 text-gs-slate-gray max-w-[700px] mx-auto leading-gs-leading-body"
        >
          {
            t(
              "projects.methodology.intro" as TranslationKey,
              lang as "bg" | "en",
            )
          }
        </p>
      </header>

      <!-- Project Filters -->
      <ProjectFilters lang={lang as "bg" | "en"} terrainTypes={terrainTypes} />

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-gs-6 mb-[120px]"
      >
        {
          sortedProjects.map((project, index) => {
            const slug =
              project.data.custom_slug ||
              project.id.split("/").slice(1).join("/").replace(/\.md$/, "");
            return (
              <ProjectCard
                title={project.data.title}
                capacityMW={project.data.capacityMW}
                location={project.data.location}
                terrainType={project.data.terrainType}
                heroImage={project.data.heroImage}
                slug={slug}
                lang={lang as "bg" | "en"}
                isVerified={project.data.isVerified}
                animationDelay={(index % 4) * 100}
              />
            );
          })
        }
      </div>

      <div class="text-center mb-gs-8">
        <h2
          class="text-gs-h2 text-gs-institutional-green font-bold m-0 font-gs-primary"
          data-aos="fade-up"
        >
          {t("projects.approachTitle" as TranslationKey, lang as "bg" | "en")}
        </h2>
      </div>

      <ProjectMethodology lang={lang as "bg" | "en"} />
    </section>
  </main>
</BaseLayout>
