---
/**
 * PROJECT DETAIL PAGE
 * ==================
 *
 * "Audit Trail" narrative structure for individual project pages.
 * Features: Challenge/Scope/Outcome sections, technical sidebar, image gallery.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import ProjectSidebar from "@components/ProjectSidebar.astro";
import GSStamp from "@components/GSStamp.astro";

// Generate paths for all project items
export const prerender = true;
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((item) => {
    const parts = item.id.split("/");
    if (parts.length < 2) {
      throw new Error(
        `Invalid project ID format: ${item.id}. Expected lang/slug.`,
      );
    }
    const lang = parts[0];
    let slug = parts.slice(1).join("/").replace(/\.md$/, "");

    // Strategy Validation: Use custom_slug if present to decouple URL from filename
    if (item.data.custom_slug) {
      slug = item.data.custom_slug;
    }

    return {
      params: { lang, slug },
      props: { item },
    };
  });
}

const { item } = Astro.props;
const { lang } = Astro.params;
const {
  title,
  capacityMW,
  location,
  terrainType,
  heroImage,
  galleryImages,
  isVerified,
  scope,
} = item.data;
const { Content } = await render(item);

// Translations
const t = {
  bg: {
    theChallenge: "Предизвикателството",
    technicalScope: "Технически Обхват",
    theOutcome: "Резултатът",
    projectGallery: "Галерия",
    backToProjects: "← Обратно към Проекти",
    requestPartnership: "Заяви Партньорство",
  },
  en: {
    theChallenge: "The Challenge",
    technicalScope: "Technical Scope",
    theOutcome: "The Outcome",
    projectGallery: "Gallery",
    backToProjects: "← Back to Projects",
    requestPartnership: "Request Partnership",
  },
};

const labels = t[lang as "bg" | "en"];
// Combine hero image and gallery images for the slider
const rawImages = [heroImage, ...(galleryImages || [])];

// Pre-optimize images for lightbox (full screen view)
// This ensures the lightbox loads a compressed WebP version instead of the original raw asset (which can be 8MB+ JPEGs)
const allImages = await Promise.all(
  rawImages.map(async (img) => {
    const optimized = await getImage({
      src: img,
      format: "webp",
      quality: 90, // High quality for lightbox
      width: 1920, // Limit width to 1920px (Full HD) to prevent massive file sizes
    });

    return {
      original: img,
      src: optimized.src,
      alt: title,
    };
  }),
);

console.log(
  "DBUG: Optimized lightbox sources:",
  allImages.map((i) => i.src),
);

// Helper: Format Capacity Logic (Inline for page script)
const formatCapacity = (mw: number) => {
  if (mw < 1) {
    return { value: Math.round(mw * 1000), unit: "kWp" };
  }
  return { value: parseFloat(mw.toFixed(2)), unit: "MW" };
};

const { value: capacityValue, unit: capacityUnitLabel } =
  formatCapacity(capacityMW);
---

<BaseLayout
  lang={lang as "bg" | "en"}
  title={title}
  description={`${title} - ${capacityValue} ${capacityUnitLabel} ${terrainType} project in ${location}`}
>
  <article class="pb-gs-10">
    <!-- Hero Slider Section -->
    <header class="relative mb-gs-10 group/hero">
      <div
        class="relative w-full h-[50vh] min-h-[400px] max-h-[600px] overflow-hidden bg-black"
        id="hero-slider"
      >
        <div
          class="flex h-full w-full transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)]"
          id="slider-track"
        >
          {
            allImages.map((img, index) => (
              <div class="min-w-full h-full relative" data-index={index}>
                <Image
                  src={img.original}
                  alt={`${title} - Image ${index + 1}`}
                  width={1920}
                  class="w-full h-full object-cover select-none cursor-pointer"
                  data-full-src={img.src}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            ))
          }
        </div>

        {
          allImages.length > 1 && (
            <>
              <button
                class="absolute top-1/2 -translate-y-1/2 left-gs-6 bg-white/10 backdrop-blur-md border border-white/20 w-12 h-12 rounded-full flex items-center justify-center cursor-pointer transition-all duration-200 hover:bg-white/20 hover:scale-110 z-20 text-white opacity-0 group-hover/hero:opacity-100"
                id="slider-prev"
                aria-label="Previous slide"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="stroke-current"
                >
                  <path
                    d="M15 18L9 12L15 6"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <button
                class="absolute top-1/2 -translate-y-1/2 right-gs-6 bg-white/10 backdrop-blur-md border border-white/20 w-12 h-12 rounded-full flex items-center justify-center cursor-pointer transition-all duration-200 hover:bg-white/20 hover:scale-110 z-20 text-white opacity-0 group-hover/hero:opacity-100"
                id="slider-next"
                aria-label="Next slide"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="stroke-current"
                >
                  <path
                    d="M9 18L15 12L9 6"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>

              <div
                class="absolute bottom-gs-6 left-1/2 -translate-x-1/2 flex gap-2 z-20"
                id="slider-indicators"
              >
                {allImages.map((_, index) => (
                  <button
                    class={`w-10 h-[3px] rounded-sm cursor-pointer transition-colors duration-300 p-0 border-none indicator-dot ${index === 0 ? "bg-gs-success-emerald" : "bg-white/40"}`}
                    aria-label={`Go to slide ${index + 1}`}
                    data-index={index}
                  />
                ))}
              </div>
            </>
          )
        }

        {
          isVerified && (
            <div class="absolute bottom-gs-6 right-gs-6 z-25 pointer-events-none drop-shadow-lg transition-transform duration-300 hover:rotate-6">
              <GSStamp size={120} />
            </div>
          )
        }
      </div>

      <div class="max-w-[1400px] mx-auto px-0 md:px-gs-4">
        <div
          class="mt-[-40px] md:mt-[-110px] relative z-30 bg-gs-executive-white p-gs-6 md:p-gs-10 rounded-none md:rounded-xl shadow-2xl max-w-[800px] mx-auto flex flex-col items-start text-left"
        >
          <div
            class="inline-flex items-baseline gap-gs-1 bg-gs-institutional-green text-white px-gs-4 py-gs-2 rounded-md mb-gs-4 font-gs-mono"
          >
            <span class="text-gs-h3 font-bold">{capacityValue}</span>
            <span class="text-gs-base opacity-90">{capacityUnitLabel}</span>
          </div>
          <h1
            class="text-gs-h1 font-bold text-gs-text-primary m-0 mb-gs-3 font-gs-primary leading-tight"
          >
            {title}
          </h1>
          <p class="text-gs-h5 text-gs-slate-gray m-0 font-medium">
            {location} • {terrainType}
          </p>
        </div>
      </div>
    </header>

    <!-- Main Content Grid -->
    <div
      class="max-w-[1400px] mx-auto px-0 md:px-gs-4 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-16 mt-24 pb-gs-12"
    >
      <!-- Main Narrative -->
      <main
        class="bg-gs-executive-white border-y md:border border-gs-slate-gray/10 rounded-none md:rounded-xl p-gs-6 md:p-16 shadow-sm"
      >
        <div
          class="prose max-w-none text-gs-base text-gs-text-primary leading-[2]
          prose-headings:font-gs-primary prose-headings:font-bold
          prose-h2:text-gs-h3 prose-h2:mb-12 prose-h2:mt-24 first:prose-h2:mt-0
          prose-h3:text-gs-h4 prose-h3:mt-16 prose-h3:mb-8
          prose-p:mb-12
          prose-ul:mb-12 prose-ul:pl-8
          prose-li:my-4"
        >
          <Content />
        </div>
      </main>

      <!-- Sidebar Column -->
      <aside class="flex flex-col gap-12 relative z-1">
        <ProjectSidebar
          capacityMW={capacityMW}
          terrainType={terrainType}
          location={location}
          isVerified={isVerified}
          lang={lang as "bg" | "en"}
          scope={scope}
        />

        <a
          href={`/${lang}/contact`}
          class="block w-full text-center bg-gs-institutional-green text-white p-gs-5 rounded-none md:rounded-xl font-bold no-underline transition-all duration-300 hover:bg-gs-institutional-green-dark hover:-translate-y-1 hover:shadow-2xl"
        >
          {labels.requestPartnership} →
        </a>
      </aside>
    </div>
  </article>

  <!-- Lightbox Modal -->
  <div
    id="lightbox"
    class="hidden fixed inset-0 z-[20000] bg-slate-950/95 backdrop-blur-md justify-center items-center p-4 md:p-10 box-border"
  >
    <button
      class="absolute top-8 right-8 text-white text-6xl font-bold p-0 bg-transparent border-none cursor-pointer z-[20002] leading-none transition-colors hover:text-gs-success-emerald"
      id="lightbox-close"
      aria-label="Close lightbox">&times;</button
    >

    <button
      class="absolute top-1/2 -translate-y-1/2 left-4 md:left-8 bg-white/10 backdrop-blur-md border border-white/20 w-14 h-14 rounded-full flex items-center justify-center cursor-pointer transition-all duration-200 hover:bg-white/20 hover:scale-110 z-[20002] text-white"
      id="lightbox-prev"
      aria-label="Previous image"
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        class="stroke-white"
      >
        <path
          d="M15 18L9 12L15 6"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <img
      class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg shadow-2xl animate-in zoom-in-90 duration-300"
      id="lightbox-img"
    />

    <button
      class="absolute top-1/2 -translate-y-1/2 right-4 md:right-8 bg-white/10 backdrop-blur-md border border-white/20 w-14 h-14 rounded-full flex items-center justify-center cursor-pointer transition-all duration-200 hover:bg-white/20 hover:scale-110 z-[20002] text-white"
      id="lightbox-next"
      aria-label="Next image"
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        class="stroke-white"
      >
        <path
          d="M9 18L15 12L9 6"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-[20002]"
      id="lightbox-indicators"
    >
      <!-- Dots will be injected here by JS -->
    </div>
  </div>
</BaseLayout>

<script>
  function setupSlider() {
    const slider = document.getElementById("hero-slider");
    if (!slider) return;

    const track = document.getElementById("slider-track");
    const slides = slider.querySelectorAll("[data-index]");
    const prevBtn = document.getElementById("slider-prev");
    const nextBtn = document.getElementById("slider-next");
    const indicators = slider.querySelectorAll(".indicator-dot");

    if (slides.length <= 1 || !track) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchEndX = 0;

    function goToSlide(index: number) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      track!.style.transform = `translateX(-${currentIndex * 100}%)`;

      indicators.forEach((ind, i) => {
        if (i === currentIndex) {
          ind.classList.add("bg-gs-success-emerald");
          ind.classList.remove("bg-white/40");
        } else {
          ind.classList.remove("bg-gs-success-emerald");
          ind.classList.add("bg-white/40");
        }
      });
    }

    prevBtn?.addEventListener("click", () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener("click", () => goToSlide(currentIndex + 1));

    indicators.forEach((ind, i) => {
      ind.addEventListener("click", () => goToSlide(i));
    });

    slider.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );
    slider.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      },
      { passive: true },
    );

    function handleSwipe() {
      const threshold = 50;
      if (touchEndX < touchStartX - threshold) goToSlide(currentIndex + 1);
      if (touchEndX > touchStartX + threshold) goToSlide(currentIndex - 1);
    }

    document.addEventListener("keydown", (e) => {
      if (document.getElementById("lightbox")?.classList.contains("hidden")) {
        if (e.key === "ArrowLeft") goToSlide(currentIndex - 1);
        if (e.key === "ArrowRight") goToSlide(currentIndex + 1);
      }
    });
  }

  function setupLightbox() {
    const lightbox = document.getElementById("lightbox");
    if (!lightbox) return;

    document.body.appendChild(lightbox);

    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const closeBtn = document.getElementById("lightbox-close");
    const lightboxPrev = document.getElementById("lightbox-prev");
    const lightboxNext = document.getElementById("lightbox-next");
    const lightboxIndicators = document.getElementById("lightbox-indicators");
    const clickableImages = Array.from(
      document.querySelectorAll("[data-full-src]"),
    );

    let currentLightboxIndex = 0;
    const imageUrls = clickableImages.map(
      (img) => img.getAttribute("data-full-src") || "",
    );

    if (lightboxIndicators) {
      lightboxIndicators.innerHTML = "";
      imageUrls.forEach((_, index) => {
        const dot = document.createElement("button");
        dot.className =
          "w-2.5 h-2.5 bg-white/40 border-none rounded-full cursor-pointer transition-all duration-300 p-0 lightbox-dot";
        if (index === 0) {
          dot.classList.add("bg-gs-success-emerald", "scale-125");
          dot.classList.remove("bg-white/40");
        }
        dot.setAttribute("aria-label", `Go to image ${index + 1}`);
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          openLightbox(index);
        });
        lightboxIndicators.appendChild(dot);
      });
    }

    function updateDots(index: number) {
      if (!lightboxIndicators) return;
      const dots = Array.from(lightboxIndicators.children);
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add("bg-gs-success-emerald", "scale-125");
          dot.classList.remove("bg-white/40");
        } else {
          dot.classList.remove("bg-gs-success-emerald", "scale-125");
          dot.classList.add("bg-white/40");
        }
      });
    }

    function openLightbox(index: number) {
      if (index < 0) index = imageUrls.length - 1;
      if (index >= imageUrls.length) index = 0;

      currentLightboxIndex = index;
      lightbox!.classList.remove("hidden");
      lightbox!.classList.add("flex");
      lightboxImg!.src = imageUrls[currentLightboxIndex];
      updateDots(currentLightboxIndex);
      document.body.style.overflow = "hidden";
    }

    clickableImages.forEach((img, index) => {
      img.addEventListener("click", () => openLightbox(index));
    });

    const closeLightbox = () => {
      lightbox!.classList.add("hidden");
      lightbox!.classList.remove("flex");
      document.body.style.overflow = "auto";
    };

    closeBtn?.addEventListener("click", closeLightbox);
    lightboxPrev?.addEventListener("click", (e) => {
      e.stopPropagation();
      openLightbox(currentLightboxIndex - 1);
    });
    lightboxNext?.addEventListener("click", (e) => {
      e.stopPropagation();
      openLightbox(currentLightboxIndex + 1);
    });
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox!.classList.contains("hidden")) {
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowLeft") openLightbox(currentLightboxIndex - 1);
        if (e.key === "ArrowRight") openLightbox(currentLightboxIndex + 1);
      }
    });
  }

  function init() {
    setupSlider();
    setupLightbox();
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>

<style is:global>
  /* Premium Narrative Styling - Expansive & Clean */
  .prose h2 {
    color: #064e3b !important;
    border-left: 5px solid #064e3b !important;
    padding-left: 1rem !important;
    margin-top: 6rem !important;
    margin-bottom: 3rem !important;
    line-height: 1.2 !important;
    font-size: 1.75rem !important;
    overflow-wrap: break-word !important;
  }

  @media (min-width: 768px) {
    .prose h2 {
      padding-left: 2rem !important;
      font-size: 2.25rem !important; /* text-gs-h2 equivalent */
      line-height: 1.1 !important;
    }
  }

  .prose h2:first-child {
    margin-top: 0 !important;
  }

  .prose strong {
    color: #064e3b !important;
    font-weight: 800 !important;
  }

  .prose p {
    margin-bottom: 2.5rem !important;
    line-height: 2 !important;
  }

  /* Technical Scope "Boolean" Look */
  /* Target the list that follows the Technical Scope header */
  .prose ul {
    list-style: none !important;
    padding-left: 0 !important;
  }

  .prose li {
    position: relative !important;
    padding-left: 2.5rem !important;
    margin-bottom: 1.5rem !important;
    display: block !important;
    font-weight: 500 !important;
    line-height: 1.5 !important;
  }

  @media (min-width: 768px) {
    .prose li {
      display: flex !important;
      align-items: center !important;
      line-height: normal !important;
    }
  }

  .prose li::before {
    content: "✓" !important;
    position: absolute !important;
    left: 0 !important;
    top: 0.25rem !important;
    width: 1.75rem !important;
    height: 1.75rem !important;
    background-color: #014e3b !important; /* Deep Green */
    color: white !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 4px !important;
    font-size: 1rem !important;
    font-weight: bold !important;
  }

  /* Specific bolding for the labels like "Role:" or "Installed capacity:" */
  .prose li strong {
    margin-right: 0.5rem !important;
  }
</style>
